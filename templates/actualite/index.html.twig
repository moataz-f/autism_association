{% extends 'base_public.html.twig' %}

{% block title %}الأخبار والمستجدات - جمعية حلم البراءة{% endblock %}

{% block body %}
<div class="py-5 bg-white border-bottom">
    <div class="container py-4 text-center">
        <h1 class="fw-900 text-navy mb-3" style="font-size: 3.5rem;">الأخبار والمستجدات</h1>
        <p class="text-muted lead fw-500">تابعوا كل ما هو جديد في حياة أطفالنا وفعاليات جمعيتنا</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        {% for item in news %}
            <div class="col-lg-4">
                <div class="card-2026 h-100 overflow-hidden border-0">
                    {% if item.imagePath %}
                        <img src="{{ vich_uploader_asset(item, 'imageFile') }}" class="w-100" style="height: 250px; object-fit: cover;">
                    {% else %}
                        <div class="bg-light-2026 d-flex align-items-center justify-content-center" style="height: 250px;">
                            <i class="bi bi-newspaper text-muted opacity-25" style="font-size: 4rem;"></i>
                        </div>
                    {% endif %}
                    <div class="p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill fw-800 px-3 py-2 small">نشاط</span>
                            <small class="text-muted fw-700">{{ item.createdAt|date('Y/m/d') }}</small>
                        </div>
                        <h4 class="fw-800 text-navy mb-3">{{ item.titre }}</h4>
                        <p class="text-muted lh-lg mb-4">{{ item.description }}</p>
                        <a href="{{ path('app_actualite_show', {slug: item.slug}) }}" class="btn-2026 bg-light text-navy border w-100 justify-content-center py-2">التفاصيل الكاملة <i class="bi bi-arrow-left ms-2"></i></a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <i class="bi bi-newspaper text-muted opacity-10" style="font-size: 6rem;"></i>
                <h3 class="text-muted mt-4">لا توجد أخبار منشورة بعد</h3>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
