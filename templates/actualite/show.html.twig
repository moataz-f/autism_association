{% extends 'base_public.html.twig' %}

{% block title %}{{ item.titre }} - جمعية حلم البراءة{% endblock %}

{% block body %}
<article class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none text-muted">الرئيسية</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('app_actualite_index') }}" class="text-decoration-none text-muted">الأخبار</a></li>
                        <li class="breadcrumb-item active text-navy fw-800" aria-current="page">{{ item.titre }}</li>
                    </ol>
                </nav>

                <h1 class="fw-900 text-navy mb-4" style="font-size: 3rem; line-height: 1.2;">{{ item.titre }}</h1>
                
                <div class="d-flex align-items-center gap-4 mb-5 text-muted fw-700 pb-4 border-bottom">
                    <span><i class="bi bi-calendar3 ms-2"></i> {{ item.createdAt|date('d F Y') }}</span>
                    <span><i class="bi bi-folder2-open ms-2"></i> أنشطة عامة</span>
                </div>

                {% if item.imagePath %}
                    <img src="{{ vich_uploader_asset(item, 'imageFile') }}" class="w-100 rounded-40 mb-5 shadow-lg" style="max-height: 600px; object-fit: cover;">
                {% endif %}

                <div class="article-content lh-lg text-navy fw-500" style="font-size: 1.15rem;">
                    {{ item.contenu|nl2br }}
                </div>

                <div class="mt-5 pt-5 border-top d-flex justify-content-between align-items-center">
                    <h5 class="fw-800 text-navy mb-0">شارك هذا الخبر:</h5>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn btn-light rounded-circle" style="width: 45px; height: 45px; display: grid; place-items: center;"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-light rounded-circle" style="width: 45px; height: 45px; display: grid; place-items: center;"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="btn btn-light rounded-circle" style="width: 45px; height: 45px; display: grid; place-items: center;"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</article>
{% endblock %}

{% block extra_css %}
<style>
    .rounded-40 { border-radius: 40px; }
    .article-content { color: #3D4451; }
</style>
{% endblock %}
