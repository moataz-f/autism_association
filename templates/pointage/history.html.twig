{% extends 'base.html.twig' %}

{% block title %}سجل حضوري{% endblock %}

{% block body %}
<div class="page-header">
    <div class="page-title">
        <h2>سجل حضوري الشخصي</h2>
        <p>مراجعة أوقات الدخول والخروج والغيابات</p>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-800">الشهر</label>
            <select name="month" class="form-select bg-light border-0 rounded-12 p-3">
                {% for m in 1..12 %}
                    <option value="{{ "%02d"|format(m) }}" {{ currentMonth == "%02d"|format(m) ? 'selected' : '' }}>
                        {{ date('2024-' ~ m ~ '-01')|date('F') }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-800">السنة</label>
            <select name="year" class="form-select bg-light border-0 rounded-12 p-3">
                {% for y in 2024..date()|date('Y') + 1 %}
                    <option value="{{ y }}" {{ currentYear == y ? 'selected' : '' }}>{{ y }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-800">
                <i class="bi bi-filter ms-2"></i> تصفية
            </button>
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">التاريخ</th>
                    <th>وقت الدخول</th>
                    <th>وقت الخروج</th>
                    <th>المدة</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                {% for p in pointages %}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-800">{{ p.date|date('Y-m-d') }}</div>
                            <small class="text-muted">{{ p.date|date('l') }}</small>
                        </td>
                        <td>
                            <span class="badge bg-soft-success text-success px-3 py-2 rounded-pill">
                                <i class="bi bi-box-arrow-in-right ms-1"></i>
                                {{ p.heureEntree|date('H:i') }}
                            </span>
                        </td>
                        <td>
                            {% if p.heureSortie %}
                                <span class="badge bg-soft-danger text-danger px-3 py-2 rounded-pill">
                                    <i class="bi bi-box-arrow-right ms-1"></i>
                                    {{ p.heureSortie|date('H:i') }}
                                </span>
                            {% else %}
                                <span class="text-muted small italic">لم يسجل خروج</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if p.heureSortie %}
                                {% set diff = p.heureEntree.diff(p.heureSortie) %}
                                <div class="fw-700">{{ diff.h }}س {{ diff.i }}د</div>
                            {% else %}
                                ---
                            {% endif %}
                        </td>
                        <td>
                            {% if p.heureSortie %}
                                <span class="badge-2026 bg-success">حاضر</span>
                            {% else %}
                                <span class="badge-2026 bg-warning">قيد العمل</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">لا توجد سجلات لهذا الشهر</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<style>
    .bg-soft-success { background-color: rgba(16, 185, 129, 0.1); }
    .bg-soft-danger { background-color: rgba(239, 68, 68, 0.1); }
    .rounded-12 { border-radius: 12px; }
</style>
{% endblock %}
