{% extends 'base_public.html.twig' %}

{% block title %}تواصل معنا - حلم البراءة{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <h2 class="fw-900 text-navy mb-4">اتصل بنا</h2>
            <p class="text-muted mb-5">نحن هنا للإجابة على جميع استفساراتكم. لا تترددوا في التواصل معنا عبر الهاتف أو البريد الإلكتروني أو زيارة مقر الجمعية.</p>

            <div class="d-flex mb-4">
                <div class="stat-icon ms-3 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-geo-alt"></i>
                </div>
                <div>
                    <h6 class="fw-800 mb-1">المقر</h6>
                    <p class="text-muted small mb-0">قبلي، تونس - الطريق الرئيسي</p>
                </div>
            </div>

            <div class="d-flex mb-4">
                <div class="stat-icon ms-3 bg-success bg-opacity-10 text-success">
                    <i class="bi bi-telephone"></i>
                </div>
                <div>
                    <h6 class="fw-800 mb-1">الهاتف</h6>
                    <p dir="ltr" class="text-end text-muted small mb-0">+216 12 345 678</p>
                </div>
            </div>

            <div class="d-flex mb-4">
                <div class="stat-icon ms-3 bg-info bg-opacity-10 text-info">
                    <i class="bi bi-envelope"></i>
                </div>
                <div>
                    <h6 class="fw-800 mb-1">البريد الإلكتروني</h6>
                    <p class="text-muted small mb-0">contact@autism-dream.tn</p>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card card-2026 p-5 border-0 shadow-lg h-100">
                <h4 class="fw-900 mb-4">أرسل لنا رسالة</h4>
                <form>
                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-700">الاسم الكامل</label>
                            <input type="text" class="form-control rounded-3" placeholder="مثال: أحمد علي">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-700">البريد الإلكتروني</label>
                            <input type="email" class="form-control rounded-3" placeholder="email@example.com">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-700">الموضوع</label>
                        <input type="text" class="form-control rounded-3" placeholder="بخصوص تسجيل طفل...">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-700">الرسالة</label>
                        <textarea class="form-control rounded-3" rows="5" placeholder="اكتب رسالتك هنا..."></textarea>
                    </div>
                    <button type="button" class="btn btn-primary w-100 py-3 fw-800 rounded-4" onclick="alert('تم إرسال رسالتك بنجاح!')">
                        إرسال الرسالة
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
    .btn-navy { background-color: var(--navy); color: white; border: none; }
    .btn-navy:hover { background-color: #2D333D; color: white; }
    .btn-outline-navy { border: 2px solid var(--navy); color: var(--navy); }
    .btn-outline-navy:hover { background-color: var(--navy); color: white; }
</style>
{% endblock %}
