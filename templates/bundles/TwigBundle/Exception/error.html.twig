{% extends 'base_public.html.twig' %}

{% block title %}خطأ تقني - عذراً{% endblock %}

{% block body %}
<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="text-center">
        <div class="error-illustration mb-5">
            <i class="bi bi-exclamation-triangle text-warning opacity-25" style="font-size: 8rem;"></i>
        </div>
        <h3 class="fw-800 text-navy mb-4">حدث خطأ تقني غير متوقع</h3>
        <p class="text-muted fw-600 mb-5 max-w-500 mx-auto">
            نحن نعتذر عن هذا الإزعاج. لقد تم تسجيل هذا الخطأ وسيقوم فريقنا التقني بمراجعته قريباً. يرجى المحاولة مرة أخرى لاحقاً.
        </p>
        <div class="d-flex gap-3 justify-content-center">
            <a href="{{ path('app_dashboard') }}" class="btn btn-2026-primary px-5 py-3 rounded-pill fw-800">
                <i class="bi bi-speedometer2 ms-2"></i> العودة للوحة التحكم
            </a>
            <a href="javascript:location.reload()" class="btn btn-2026-light px-5 py-3 rounded-pill fw-800 border">
                <i class="bi bi-arrow-clockwise ms-2"></i> تحديث الصفحة
            </a>
        </div>
    </div>
</div>

<style>
    .max-w-500 { max-width: 500px; }
</style>
{% endblock %}
