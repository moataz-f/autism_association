{% extends 'base_public.html.twig' %}

{% block title %}دخول غير مصرح - 403{% endblock %}

{% block body %}
<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="text-center">
        <div class="error-illustration mb-5">
            <i class="bi bi-shield-lock text-danger opacity-25" style="font-size: 8rem;"></i>
        </div>
        <h1 class="fw-900 text-navy mb-3 display-4">403</h1>
        <h3 class="fw-800 text-navy mb-4">ليس لديك الصلاحية للوصول لهذه الصفحة</h3>
        <p class="text-muted fw-600 mb-5 max-w-500 mx-auto">
            عذراً، هذه المنطقة محمية أو مخصصة لمسؤولين بصفات معينة. يرجى التأكد من حسابك أو العودة للوحة التحكم.
        </p>
        <div class="d-flex gap-3 justify-content-center">
            <a href="{{ path('app_dashboard') }}" class="btn btn-navy px-5 py-3 rounded-pill fw-800 text-white">
                <i class="bi bi-speedometer2 ms-2"></i> لوحة التحكم
            </a>
            <a href="{{ path('app_home') }}" class="btn btn-2026-light px-5 py-3 rounded-pill fw-800 border">
                <i class="bi bi-house-door ms-2"></i> الرئيسية
            </a>
        </div>
    </div>
</div>

<style>
    .max-w-500 { max-width: 500px; }
    .error-illustration i {
        display: inline-block;
        animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
        0% { transform: scale(1); opacity: 0.25; }
        50% { transform: scale(1.1); opacity: 0.4; }
        100% { transform: scale(1); opacity: 0.25; }
    }
</style>
{% endblock %}
