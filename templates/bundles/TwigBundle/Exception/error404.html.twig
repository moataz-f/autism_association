{% extends 'base_public.html.twig' %}

{% block title %}الصفحة غير موجودة - 404{% endblock %}

{% block body %}
<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="text-center">
        <div class="error-illustration mb-5">
            <i class="bi bi-search text-primary opacity-25" style="font-size: 8rem;"></i>
        </div>
        <h1 class="fw-900 text-navy mb-3 display-4">404</h1>
        <h3 class="fw-800 text-navy mb-4">عذراً، الصفحة التي تبحث عنها غير موجودة</h3>
        <p class="text-muted fw-600 mb-5 max-w-500 mx-auto">
            يبدو أن الرابط الذي اتبعته قديم أو تم نقل الصفحة. يمكنك العودة إلى الصفحة الرئيسية أو التواصل معنا إذا كنت تعتقد أن هذا خطأ.
        </p>
        <div class="d-flex gap-3 justify-content-center">
            <a href="{{ path('app_home') }}" class="btn btn-2026-primary px-5 py-3 rounded-pill fw-800">
                <i class="bi bi-house-door ms-2"></i> العودة للرئيسية
            </a>
            <a href="javascript:history.back()" class="btn btn-2026-light px-5 py-3 rounded-pill fw-800 border">
                <i class="bi bi-arrow-right ms-2"></i> رجوع
            </a>
        </div>
    </div>
</div>

<style>
    .max-w-500 { max-width: 500px; }
    .error-illustration i {
        display: inline-block;
        animation: float 4s ease-in-out infinite;
    }
    @keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
        100% { transform: translateY(0px); }
    }
</style>
{% endblock %}
