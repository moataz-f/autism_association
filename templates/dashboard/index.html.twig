{% extends 'base.html.twig' %}

{% block title %}لوحة القيادة{% endblock %}

{% block body %}
<div class="page-header">
    <div class="page-title">
        <h2>لوحة القيادة والمتابعة</h2>
        <p>نظرة شاملة على نشاط جمعية حلم البراءة</p>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-lg-3">
        <div class="card h-100 p-4 border-0">
            <div class="d-flex flex-column h-100">
                <div class="stat-icon-2026 mb-4" style="background: rgba(37, 99, 235, 0.08); color: var(--primary);">
                    <i class="bi bi-person-heart"></i>
                </div>
                <h3 class="fw-900 mb-1">{{ totalBeneficiaires }}</h3>
                <span class="text-muted fw-600 small">طفل منتفع مسجل</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card h-100 p-4 border-0">
            <div class="d-flex flex-column h-100">
                <div class="stat-icon-2026 mb-4" style="background: rgba(16, 185, 129, 0.08); color: var(--secondary);">
                    <i class="bi bi-house-door"></i>
                </div>
                <h3 class="fw-900 mb-1">{{ totalFamilles }}</h3>
                <span class="text-muted fw-600 small">عائلة مسجلة حالياً</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card h-100 p-4 border-0">
            <div class="d-flex flex-column h-100">
                <div class="stat-icon-2026 mb-4" style="background: rgba(245, 158, 11, 0.08); color: var(--warning);">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h3 class="fw-900 mb-1">{{ totalActivites }}</h3>
                <span class="text-muted fw-600 small">نشاط مبرمج هذا الشهر</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card h-100 p-4 border-0">
            <div class="d-flex flex-column h-100">
                <div class="stat-icon-2026 mb-4" style="background: rgba(239, 68, 68, 0.08); color: var(--danger);">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h3 class="fw-900 mb-1">{{ totalPersonnel }}</h3>
                <span class="text-muted fw-600 small">موظف ومتطوع فعال</span>
            </div>
        </div>
    </div>
</div>

{# New: Employee Personal Attendance Block #}
{% if is_granted('ROLE_PERSONNEL') or is_granted('ROLE_EDUCATEUR') %}
<div class="card card-2026 border-0 shadow-sm mb-4 p-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);">
    <div class="row align-items-center position-relative" style="z-index: 2;">
        <div class="col-md-8 text-white">
            <h4 class="fw-900 mb-2">تسجيل الحضور اليومي</h4>
            <p class="opacity-75 mb-0 fw-600">يمكنك تسجيل دخولك أو خروجك بمسح الرمز اليومي الخاص بالجمعية.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a href="{{ path('app_pointage_scan') }}" class="btn btn-white px-4 py-2 fw-800 rounded-pill shadow-sm">
                <i class="bi bi-camera ms-2"></i> تـسـجيل بـالـكاميرا
            </a>
        </div>
    </div>
    <i class="bi bi-clock-history position-absolute end-0 bottom-0 opacity-10" style="font-size: 8rem; transform: translate(20%, 20%); color: white;"></i>
</div>
{% endif %}

<div class="row g-4">
    {# Big Bento Section: Quick Access #}
    <div class="col-lg-8">
        <div class="card h-100 p-5 border-0">
            <h5 class="fw-900 mb-5 d-flex align-items-center">
                <i class="bi bi-lightning-charge-fill ms-3 text-warning"></i>
                الوصول السريع والعمليات
            </h5>
            <div class="row g-4">
                <div class="col-md-3">
                    <a href="{{ path('app_beneficiaire_index') }}" class="bento-link">
                        <div class="b-icon"><i class="bi bi-people-fill"></i></div>
                        <span>المنتفعون</span>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="{{ path('app_famille_index') }}" class="bento-link">
                        <div class="b-icon"><i class="bi bi-house-heart-fill"></i></div>
                        <span>العائلات</span>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="{{ path('admin_donation_index') }}" class="bento-link">
                        <div class="b-icon"><i class="bi bi-gift-fill"></i></div>
                        <span>التبرعات</span>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="{{ path('admin_seance_index') }}" class="bento-link">
                        <div class="b-icon"><i class="bi bi-clock-fill"></i></div>
                        <span>الجدولة</span>
                    </a>
                </div>
            </div>

            <div class="mt-5 pt-5 border-top">
                <h5 class="fw-900 mb-4">النشر الرقمي</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <a href="{{ path('admin_content_index') }}" class="bento-sublink">
                            <div class="s-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-pencil-square"></i></div>
                            <div>
                                <h6 class="mb-0 fw-800">محتوى الصفحات</h6>
                                <p class="mb-0 small text-muted">إدارة النصوص والروابط</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="{{ path('admin_gallery_index') }}" class="bento-sublink">
                            <div class="s-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-images"></i></div>
                            <div>
                                <h6 class="mb-0 fw-800">معرض الصور</h6>
                                <p class="mb-0 small text-muted">تحديث ألبوم الجمعية</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Sidebar Bento: System #}
    <div class="col-lg-4">
        <div class="card h-100 p-5 border-0 bg-dark text-white shadow-lg" style="background: var(--text-main) !important;">
            <h5 class="fw-900 mb-4">إدارة النظام</h5>
            <div class="d-flex flex-column gap-3">
                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_user_index') }}" class="sys-link-dark">
                    <i class="bi bi-shield-lock ms-3"></i>
                    <span>الصلاحيات والمستخدمين</span>
                </a>
                {% endif %}
                <a href="{{ path('app_profile_edit') }}" class="sys-link-dark">
                    <i class="bi bi-person-circle ms-3"></i>
                    <span>إعدادات الحساب</span>
                </a>
            </div>

            <div class="mt-auto pt-5">
                <div class="premium-support-box p-4 rounded-4" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-icon ms-3"><i class="bi bi-headset"></i></div>
                        <h6 class="mb-0 fw-800">الدعم الذكي 2026</h6>
                    </div>
                    <p class="small text-white-50 mb-0">نظام المساعدة المتقدم متاح دائماً لخدمتكم.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-icon-2026 {
        width: 56px;
        height: 56px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
    .fw-900 { font-weight: 900; }
    .fw-800 { font-weight: 800; }
    
    .bento-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.5rem 1.5rem;
        background: #F8FAFC;
        border-radius: var(--radius-bento);
        text-decoration: none;
        color: var(--text-main);
        font-weight: 800;
        transition: var(--transition-smooth);
    }
    .b-icon { font-size: 2.5rem; margin-bottom: 1rem; color: var(--primary); }
    .bento-link:hover { background: white; box-shadow: var(--shadow-hover); transform: scale(1.05); }

    .bento-sublink {
        display: flex;
        align-items: center;
        padding: 1.5rem;
        background: #F8FAFC;
        border-radius: 20px;
        text-decoration: none;
        color: inherit;
        transition: var(--transition-smooth);
    }
    .bento-sublink:hover { background: white; box-shadow: var(--shadow-neo); }
    .s-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-left: 1rem; font-size: 1.2rem; }

    .sys-link-dark {
        display: flex;
        align-items: center;
        padding: 1rem 1.25rem;
        background: rgba(255,255,255,0.03);
        border-radius: 15px;
        text-decoration: none;
        color: rgba(255,255,255,0.7);
        font-weight: 600;
        transition: var(--transition-smooth);
    }
    .sys-link-dark:hover { background: rgba(255,255,255,0.1); color: white; }
    
    .p-icon { font-size: 1.5rem; color: var(--primary); }
</style>
{% endblock %}