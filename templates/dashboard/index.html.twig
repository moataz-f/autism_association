{% extends 'base.html.twig' %}

{% block title %}لوحة القيادة{% endblock %}

{% block body %}
<div class="page-header">
    <div class="page-title">
        <h2>لوحة القيادة والمتابعة</h2>
        <p>نظرة شاملة على نشاط جمعية حلم البراءة</p>
    </div>
</div>

    {% if is_granted('ROLE_ADMIN') %}
        {{ include('dashboard/_admin.html.twig') }}
    {% elseif is_granted('ROLE_SPECIALISTE') or is_granted('ROLE_SPECIALIST') %}
        {{ include('dashboard/_specialist.html.twig') }}
    {% elseif is_granted('ROLE_PARENT') %}
        {{ include('dashboard/_parent.html.twig') }}
    {% else %}
        <div class="card p-5 border-0 shadow-sm text-center">
            <i class="bi bi-shield-lock text-muted opacity-25 mb-4" style="font-size: 4rem;"></i>
            <h4 class="fw-900 text-navy mb-3">حسابك في انتظار التفعيل</h4>
            <p class="text-muted fw-600">شكراً لانضمامك إلينا. يقوم مدير النظام حالياً بمراجعة حسابك وتفعيل الصلاحيات المناسبة لك.</p>
            <div class="mt-4">
                <a href="{{ path('app_home') }}" class="btn btn-navy py-2 px-5 rounded-pill fw-800 text-white">العودة للرئيسية</a>
            </div>
        </div>
    {% endif %}

    <script>
    document.querySelectorAll('.toggle-task').forEach(btn => {
        btn.addEventListener('click', async function() {
            const taskId = this.dataset.id;
            const icon = this.querySelector('i');
            const title = document.querySelector('.task-title-' + taskId);
            
            try {
                const response = await fetch('/personnel/task/' + taskId + '/toggle', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await response.json();
                
                if (data.success) {
                    if (data.newStatus === 'COMPLETED') {
                        icon.className = 'bi bi-check-circle-fill text-success fs-4';
                        title.classList.add('text-decoration-line-through', 'text-muted');
                    } else {
                        icon.className = 'bi bi-circle text-muted fs-4';
                        title.classList.remove('text-decoration-line-through', 'text-muted');
                    }
                }
            } catch (error) {
                console.error('Error toggling task:', error);
            }
        });
    });
    </script>

    <style>
        .cursor-pointer { cursor: pointer; }
        .hover-bg-light:hover { background: rgba(0,0,0,0.05); }

        .stat-icon-2026 {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }
        .fw-900 { font-weight: 900; }
        .fw-800 { font-weight: 800; }
        
        .bento-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2.5rem 1.5rem;
            background: #F8FAFC;
            border-radius: var(--radius-bento);
            text-decoration: none;
            color: var(--text-main);
            font-weight: 800;
            transition: var(--transition-smooth);
        }
        .b-icon { font-size: 2.5rem; margin-bottom: 1rem; color: var(--primary); }
        .bento-link:hover { background: white; box-shadow: var(--shadow-hover); transform: scale(1.05); }

        .bento-sublink {
            display: flex;
            align-items: center;
            padding: 1.5rem;
            background: #F8FAFC;
            border-radius: 20px;
            text-decoration: none;
            color: inherit;
            transition: var(--transition-smooth);
        }
        .bento-sublink:hover { background: white; box-shadow: var(--shadow-neo); }
        .s-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-left: 1rem; font-size: 1.2rem; }

        .sys-link-dark {
            display: flex;
            align-items: center;
            padding: 1rem 1.25rem;
            background: rgba(255,255,255,0.03);
            border-radius: 15px;
            text-decoration: none;
            color: rgba(255,255,255,0.7);
            font-weight: 600;
            transition: var(--transition-smooth);
        }
        .sys-link-dark:hover { background: rgba(255,255,255,0.1); color: white; }
        
        .p-icon { font-size: 1.5rem; color: var(--primary); }

        .btn-navy { background: var(--text-main) !important; color: white !important; }
        .btn-white { background: white !important; color: var(--primary) !important; }
        .rounded-16 { border-radius: 16px; }
        .rounded-24 { border-radius: 24px; }
    </style>
{% endblock %}