{% extends 'base.html.twig' %}

{% block title %}ملفات الأطفال - فضاء الأولياء{% endblock %}

{% block body %}
<div class="page-header justify-content-between">
    <div class="page-title">
        <h2>أطفالي</h2>
        <p>متابعة الملفات الشخصية للأبناء المسجلين</p>
    </div>
    <a href="{{ path('app_parent_registration_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg ms-2"></i> تسجيل طفل جديد
    </a>
</div>

<div class="row g-4">
    {% for child in children %}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <div class="avatar-sq ms-3 bg-primary bg-opacity-10 text-primary" style="width: 64px; height: 64px; font-size: 1.5rem;">
                            {{ child.prenom|first|upper }}{{ child.nom|first|upper }}
                        </div>
                        <div>
                            <h5 class="fw-800 mb-1">{{ child.prenom }} {{ child.nom }}</h5>
                            <span class="badge-2026 bg-info bg-opacity-10 text-info">
                                {{ child.niveauAutisme }}
                            </span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-2">
                            <span class="text-muted">تاريخ الولادة:</span>
                            <span class="fw-700">{{ child.dateNaissance|date('d/m/Y') }}</span>
                        </div>
                        <div class="d-flex justify-content-between small mb-2">
                            <span class="text-muted">العمر:</span>
                            <span class="fw-700">{{ child.age }} سنوات</span>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">تاريخ التسجيل:</span>
                            <span class="fw-700">{{ child.dateInscription|date('d/m/Y') }}</span>
                        </div>
                    </div>

                    <div class="pt-3 border-top mt-auto">
                        <div class="d-grid gap-2">
                            <a href="{{ path('app_parent_sessions') }}?child={{ child.id }}" class="btn btn-sm btn-outline-primary rounded- pill">
                                <i class="bi bi-calendar-event me-2"></i> جدول الحصص
                            </a>
                            <a href="{{ path('app_parent_reports') }}?child={{ child.id }}" class="btn btn-sm btn-outline-secondary rounded-pill">
                                <i class="bi bi-file-earmark-medical me-2"></i> التقارير
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <div class="card border-0 py-5">
                <i class="bi bi-person-x text-muted opacity-25" style="font-size: 5rem;"></i>
                <h4 class="text-muted mt-4">لا يوجد أطفال مسجلون حالياً</h4>
                <p class="text-muted small">يرجى التواصل مع الإدارة أو تقديم طلب تسجيل طفل جديد.</p>
                <div class="mt-3">
                    <a href="{{ path('app_parent_registration_new') }}" class="btn btn-primary px-4 rounded-pill">تسجيل طفل جديد</a>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
