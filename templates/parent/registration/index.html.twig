{% extends 'base.html.twig' %}

{% block title %}طلبات التسجيل - فضاء الأولياء{% endblock %}

{% block body %}
<div class="page-header justify-content-between">
    <div class="page-title">
        <h2>طلبات التسجيل السابقة</h2>
        <p>متابعة حالة الطلبات المقدمة لإضافة أطفال</p>
    </div>
    <a href="{{ path('app_parent_registration_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg ms-2"></i> طلب جديد
    </a>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead>
                    <tr>
                        <th class="text-end ps-4">اسم الطفل</th>
                        <th>التاريخ</th>
                        <th>مستوى التوحد</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                {% for req in requests %}
                    <tr>
                        <td class="text-end ps-4">
                            <div class="fw-800 text-main">{{ req.prenom }} {{ req.nom }}</div>
                        </td>
                        <td class="fw-600 text-muted">{{ req.createdAt|date('Y/m/d') }}</td>
                        <td>
                            <span class="badge-2026 bg-info bg-opacity-10 text-info">{{ req.niveauAutisme }}</span>
                        </td>
                        <td>
                            {% if req.status == 'PENDING' %}
                                <span class="badge-2026 bg-warning bg-opacity-10 text-warning">قيد الانتظار</span>
                            {% elseif req.status == 'APPROVED' %}
                                <span class="badge-2026 bg-success bg-opacity-10 text-success">مقبول</span>
                            {% else %}
                                <span class="badge-2026 bg-danger bg-opacity-10 text-danger">مرفوض</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <p class="text-muted fw-600">لا توجد طلبات تسجيل سابقة.</p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
