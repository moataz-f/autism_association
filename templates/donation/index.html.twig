{% extends 'base_public.html.twig' %}

{% block title %}حملات التبرع{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-900 text-primary mb-3">ساهم في دعمنا</h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 700px;">
            مساهمتكم تصنع فرقاً حقيقياً في حياة أطفال التوحد. تصفح حملاتنا المفتوحة وشارك في الخير.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="tel:+21612345678" class="btn btn-navy btn-lg px-4 py-2 rounded-pill fw-bold shadow-sm">
                <i class="bi bi-telephone-fill me-2"></i> اتصل الآن للتبرع
            </a>
            <a href="{{ path('app_donation_request') }}" class="btn btn-primary btn-lg px-4 py-2 rounded-pill fw-bold shadow-sm">
                <i class="bi bi-credit-card-fill me-2"></i> تبرع إلكترونياً
            </a>
        </div>
    </div>

    <div class="row g-4">
        {% for campaign in campaigns %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                <i class="bi bi-heart-fill me-1"></i> تبرع
                            </span>
                            <small class="text-muted fw-bold">ينتهي: {{ campaign.dateFin|date('Y-m-d') }}</small>
                        </div>
                        
                        <h4 class="fw-bold mb-3">{{ campaign.titre }}</h4>
                        <p class="text-muted mb-4 flex-grow-1">
                            {{ campaign.description|slice(0, 100) }}...
                        </p>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between mb-2 fw-bold text-dark">
                                <span>{{ campaign.montantCollecte|number_format(0) }} د.ت</span>
                                <span class="text-muted small">من {{ campaign.montantObjectif|number_format(0) }} د.ت</span>
                            </div>
                            <div class="progress" style="height: 10px; border-radius: 10px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: {{ campaign.pourcentage }}%" aria-valuenow="{{ campaign.pourcentage }}" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="mt-3 text-end">
                                {% if campaign.isFilled %}
                                    <button class="btn btn-secondary w-100 fw-bold rounded-pill" disabled>
                                        <i class="bi bi-check-circle-fill me-1"></i> مكتملة
                                    </button>
                                {% else %}
                                    <a href="{{ path('app_donation_show', {'id': campaign.id}) }}" class="btn btn-outline-primary w-100 fw-bold rounded-pill">
                                        تفاصيل الحملة <i class="bi bi-arrow-left"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <i class="bi bi-heart text-muted opacity-25" style="font-size: 4rem;"></i>
                <h3 class="mt-3 text-muted fw-bold">لا توجد حملات نشطة حالياً</h3>
                <p class="text-muted">شكراً لاهتمامكم. يرجى العودة لاحقاً.</p>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    .hover-lift { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important; }
    .btn-navy { background-color: var(--navy); color: white; border: none; }
    .btn-navy:hover { background-color: #2d323b; color: white; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
</style>
{% endblock %}
