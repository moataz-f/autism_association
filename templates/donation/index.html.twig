{% extends 'base_public.html.twig' %}

{% block title %}حملات التبرع{% endblock %}

{% block body %}
<div class="hero-mini py-5">
    <div class="container py-4">
        <div class="text-center mb-5 animate__animated animate__fadeIn">
            <h1 class="fw-900 text-navy mb-3 display-4">ساهم في <span class="text-primary italic-2026">الخـير</span></h1>
            <p class="lead text-muted mx-auto mb-5 opacity-75" style="max-width: 600px;">
                مساهمتكم تصنع فرقاً حقيقياً في حياة أطفال التوحد. تصفح حملاتنا المفتوحة وشارك في رحلة الأمل.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-4">
                <a href="tel:+21612345678" class="btn-2026-outline px-5 py-3">
                    <i class="bi bi-telephone-fill ms-2"></i> اتصل الآن للتبرع
                </a>
                <a href="{{ path('app_donation_request') }}" class="btn-2026-primary px-5 py-3">
                    <i class="bi bi-credit-card-fill ms-2"></i> تبرع إلكترونياً
                </a>
            </div>
        </div>

        <div class="row g-5">
            {% for campaign in campaigns %}
                <div class="col-md-6 col-lg-4">
                    <div class="bento-card border-0 shadow-premium h-100 p-4 animate__animated animate__zoomIn" style="--animate-delay: {{ loop.index0 * 0.1 }}s">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="badge-2026">
                                <i class="bi bi-heart-fill me-1"></i> حملة نشطة
                            </div>
                            <div class="small fw-bold opacity-50">
                                <i class="bi bi-calendar3 me-1"></i> {{ campaign.dateFin|date('d/m/Y') }}
                            </div>
                        </div>
                        
                        <h4 class="fw-900 mb-3 text-navy">{{ campaign.titre }}</h4>
                        <p class="text-muted mb-4 small opacity-75 line-clamp-3">
                            {{ campaign.description }}
                        </p>

                        <div class="mt-auto pt-4 border-top border-micro">
                            {% if is_granted('ROLE_ADMIN') %}
                            <div class="d-flex justify-content-between mb-3 align-items-end">
                                <div>
                                    <h5 class="mb-0 fw-900 text-primary">{{ campaign.montantCollecte|number_format(0) }} د.ت</h5>
                                    <small class="text-muted opacity-50">مجموع التبرعات</small>
                                </div>
                                <div class="text-end">
                                    <h5 class="mb-0 fw-800 text-navy">{{ campaign.pourcentage }}%</h5>
                                    <small class="text-muted opacity-50">الهدف: {{ campaign.montantObjectif|number_format(0) }}</small>
                                </div>
                            </div>
                            
                            <div class="progress-2026 mb-4">
                                <div class="bar" style="width: {{ campaign.pourcentage }}%"></div>
                            </div>
                            {% else %}
                                <div class="mb-4"></div>
                            {% endif %}

                            {% if campaign.isFilled %}
                                <div class="filled-seal py-2 rounded-pill text-center w-100">
                                    <i class="bi bi-patch-check-fill me-1"></i> حملة مكتملة
                                </div>
                            {% else %}
                                <a href="{{ path('app_donation_request', {'campaign': campaign.id}) }}" class="btn-2026-primary w-100 py-3">
                                    تبرع الآن <i class="bi bi-arrow-left ms-2"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5 glass-card bento-card border-0">
                    <i class="bi bi-heart text-primary opacity-25 mb-4 d-block" style="font-size: 5rem;"></i>
                    <h2 class="fw-900 text-navy">لا توجد حملات نشطة حالياً</h2>
                    <p class="text-muted opacity-75">نحن دائماً نخطط لمبادرات جديدة. شكراً لاهتمامكم.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #8E97FD;
        --navy: #3D4451;
        --border-micro: rgba(74, 78, 105, 0.06);
        --shadow-premium: 0 20px 40px rgba(0,0,0,0.03);
    }

    .hero-mini {
        background: radial-gradient(circle at top left, #FDFBFA 0%, #F1F4FF 100%);
        min-height: 80vh;
    }

    .italic-2026 { font-style: italic; position: relative; }
    .italic-2026::after {
        content: ''; position: absolute; bottom: 5px; left: 0; right: 0;
        height: 8px; background: var(--primary); opacity: 0.1; z-index: -1;
    }

    .btn-2026-primary {
        background: var(--primary);
        color: white; border: none; border-radius: 20px;
        font-weight: 800; text-decoration: none;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 10px 20px rgba(142, 151, 253, 0.2);
    }
    .btn-2026-primary:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(142, 151, 253, 0.3);
        color: white;
    }

    .btn-2026-outline {
        background: white;
        color: var(--navy); border: 2px solid #F1F4FF; border-radius: 20px;
        font-weight: 800; text-decoration: none;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all 0.4s ease;
    }
    .btn-2026-outline:hover {
        background: #F1F4FF; border-color: var(--primary); transform: translateY(-3px);
    }

    .bento-card {
        background: white;
        border-radius: 32px;
        transition: all 0.4s ease;
    }
    .bento-card:hover { transform: scale(1.02); box-shadow: 0 30px 60px rgba(0,0,0,0.05); }

    .badge-2026 {
        background: #F1F4FF; color: var(--primary);
        font-weight: 900; font-size: 0.75rem;
        padding: 0.5rem 1rem; border-radius: 12px;
        letter-spacing: 0.5px; text-transform: uppercase;
    }

    .progress-2026 {
        height: 8px; background: #F1F4FF; border-radius: 10px; overflow: hidden;
    }
    .progress-2026 .bar {
        height: 100%; background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
        border-radius: 10px; transition: width 1s ease-in-out;
    }

    .filled-seal {
        background: #F1F4FF; color: var(--navy);
        font-weight: 900; opacity: 0.7;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
</style>
{% endblock %}
