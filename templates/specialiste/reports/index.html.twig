{% extends 'base.html.twig' %}

{% block title %}تقارير المتابعة{% endblock %}

{% block body %}
<div class="page-header">
    <div class="page-title">
        <h2>تقارير المتابعة</h2>
        <p>إدارة التقارير والتقييمات التي قمت بكتابتها</p>
    </div>
    <div class="page-actions">
        <a href="{{ path('app_specialiste_report_new') }}" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg ms-2"></i> تقرير جديد
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">التاريخ</th>
                    <th>الطفل</th>
                    <th>نوع التقرير</th>
                    <th>لمحة عن المحتوى</th>
                    <th class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                {% for report in reports %}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-800">{{ report.date|date('Y-m-d') }}</div>
                        </td>
                        <td>
                            <div class="fw-700 text-primary">{{ report.beneficiaire.nom }} {{ report.beneficiaire.prenom }}</div>
                        </td>
                        <td>
                            <span class="badge-2026 bg-light text-primary border border-primary border-opacity-25">
                                {{ report.type }}
                            </span>
                        </td>
                        <td style="max-width: 300px;">
                            <div class="text-muted small text-truncate">{{ report.contenu }}</div>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('app_specialiste_report_edit', {'id': report.id}) }}" class="action-btn-2026" title="تعديل">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                {# We can add a view/modal for the full content later #}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">لم تقم بكتابة أي تقارير بعد</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
