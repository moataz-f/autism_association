{% extends 'base.html.twig' %}

{% block title %}إضافة موظف جديد{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-0">إضافة موظف جديد</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">لوحة القيادة</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_personnel_index') }}">الموظفون</a></li>
                <li class="breadcrumb-item active">إضافة</li>
            </ol>
        </nav>
    </div>
    <a href="{{ path('app_personnel_index') }}" class="btn btn-light">
        <i class="bi bi-arrow-right"></i> العودة للقائمة
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="alert alert-info border-0 shadow-sm mb-4">
            <div class="d-flex">
                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-1">معلومات الحساب التلقائي</h5>
                    <p class="mb-0">عند إضافة موظف جديد، سيتم تلقائيًا إنشاء حساب مستخدم له بالبريد الإلكتروني المدخل وكلمة مرور افتراضية: <strong>pass123</strong></p>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                {{ include('personnel/_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
