<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}جمعية حلم البراءة{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        /* ===== Design System: Vibrant & Friendly Colors ===== */
        :root {
            --primary-blue: #2563EB;
            --secondary-green: #10B981;
            --accent-amber: #F59E0B;
            --bg-light: #F8FAFC;
            --text-dark: #0F172A;
            --sidebar-dark: #1E293B;
            --sidebar-text: #E2E8F0;
            --border-color: #E2E8F0;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --sidebar-width: 260px;
        }

        /* ===== Typography ===== */
        body {
            direction: rtl;
            text-align: right;
            font-family: 'Tajawal', 'Segoe UI', Tahoma, sans-serif;
            font-size: 16px;
            line-height: 1.6;
            color: var(--text-dark);
            background: var(--bg-light);
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 1.25rem;
        }

        /* ===== Sidebar (Fixed & Independent) ===== */
        .sidebar {
            height: 100vh;
            background: var(--sidebar-dark);
            position: fixed;
            top: 0;
            right: 0;
            width: var(--sidebar-width);
            z-index: 1050;
            box-shadow: 4px 0 15px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            overflow-y: auto;
            border-left: 1px solid rgba(255,255,255,0.05);
        }

        /* Customize Scrollbar for Sidebar */
        .sidebar::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
        }

        .sidebar-header {
            padding: 2.5rem 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.02);
            flex-shrink: 0;
        }

        .sidebar-header h4 {
            margin: 0;
            font-weight: 700;
            display: flex;
            align-items: center;
            color: white;
            font-size: 1.25rem;
        }

        .sidebar-header i {
            margin-left: 0.5rem;
            font-size: 1.5rem;
            color: var(--primary-blue);
        }

        .sidebar-header small {
            color: #94A3B8;
            font-size: 0.85rem;
            display: block;
            margin-top: 0.25rem;
        }

        .sidebar .nav-link {
            color: var(--sidebar-text);
            padding: 0.65rem 1.25rem;
            margin: 0.1rem 0.6rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            font-size: 0.95rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .sidebar .nav-link i {
            margin-left: 0.6rem;
            font-size: 1.15rem;
            color: #64748B;
            transition: all 0.2s ease;
        }

        .sidebar .nav-link:hover {
            background: rgba(255,255,255,0.05);
            color: white;
        }

        .sidebar .nav-link:hover i {
            color: var(--primary-blue);
        }

        .sidebar .nav-link.active {
            background: var(--primary-blue);
            color: white;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .sidebar .nav-link.active i {
            color: white;
        }

        hr.sidebar-divider {
            border-color: rgba(255,255,255,0.1);
            margin: 0.75rem 0;
        }

        .nav-section-title {
            color: #64748B;
            font-size: 0.75rem;
            text-transform: uppercase;
            padding: 0.5rem 1.25rem;
            margin-top: 0.5rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .sidebar-footer {
            padding: 1.25rem;
            border-top: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.02);
            margin-top: auto;
            flex-shrink: 0;
        }

        /* ===== Main Content ===== */
        .main-content {
            margin-right: var(--sidebar-width);
            padding: 2.25rem;
            min-height: 100vh;
            width: calc(100% - var(--sidebar-width));
        }

        /* ===== Cards (More Depth) ===== */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: var(--card-shadow);
            margin-bottom: 1.5rem;
            background: white;
            transition: transform 0.2s ease;
        }

        .card-body {
            padding: 2rem;
        }

        /* ===== Page Header ===== */
        .page-header {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            margin-bottom: 2rem;
            box-shadow: var(--card-shadow);
        }

        .breadcrumb-item a {
            color: var(--primary-blue);
            font-weight: 500;
        }

        /* ===== Buttons (Vibrant & Compact) ===== */
        .btn-primary, .btn {
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn {
            padding: 0.6rem 1.25rem;
            font-size: 0.95rem;
        }

        .btn-sm {
            padding: 0.4rem 0.85rem;
            font-size: 0.85rem;
        }

        .btn-primary {
            background: var(--primary-blue);
            border: none;
            color: white;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }

        .btn-primary:hover {
            background: #1D4ED8;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(37, 99, 235, 0.3);
        }

        /* ===== Tables ===== */
        .table thead {
            background: #F1F5F9;
        }

        .table td {
            padding: 1rem 0.75rem;
            font-size: 0.95rem;
        }

        /* ===== Badges (Saturated) ===== */
        .badge {
            padding: 0.45rem 0.85rem;
            font-weight: 600;
            font-size: 0.8rem;
        }

        .bg-primary { background-color: var(--primary-blue) !important; color: white !important; }
        .bg-success { background-color: var(--secondary-green) !important; color: white !important; }
        .bg-warning { background-color: var(--accent-amber) !important; color: white !important; }
        .bg-danger { background-color: #EF4444 !important; color: white !important; }

        @media (max-width: 768px) {
            .sidebar { width: 100%; position: relative; min-height: auto; }
            .main-content { margin-right: 0; padding: 1.5rem; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            {# Sidebar #}
            <div class="sidebar">
                <div class="sidebar-header">
                    <h4>
                        <i class="bi bi-heart-fill"></i>
                        حلم البراءة
                    </h4>
                    <small>نظام الإدارة المتكامل</small>
                </div>
                
                <nav class="nav flex-column py-3">
                    <a class="nav-link {{ app.request.get('_route') == 'app_dashboard' ? 'active' : '' }}" 
                       href="{{ path('app_dashboard') }}">
                        <i class="bi bi-grid-1x2-fill"></i>
                        لوحة القيادة
                    </a>
                    
                    <hr class="sidebar-divider">
                    <div class="nav-section-title">إدارة الجمعية</div>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_beneficiaire' ? 'active' : '' }}" 
                       href="{{ path('app_beneficiaire_index') }}">
                        <i class="bi bi-person-heart"></i>
                        المنتفعون
                    </a>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_famille' ? 'active' : '' }}" 
                       href="{{ path('app_famille_index') }}">
                        <i class="bi bi-house-fill"></i>
                        العائلات
                    </a>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_activite' ? 'active' : '' }}" 
                       href="{{ path('app_activite_index') }}">
                        <i class="bi bi-calendar3"></i>
                        الأنشطة
                    </a>

                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_seance' ? 'active' : '' }}" 
                       href="{{ path('admin_seance_index') }}">
                        <i class="bi bi-clock-fill"></i>
                        جدول الحصص
                    </a>
                    
                    {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_personnel' ? 'active' : '' }}" 
                       href="{{ path('app_personnel_index') }}">
                        <i class="bi bi-person-badge-fill"></i>
                        الموظفون
                    </a>

                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_user' ? 'active' : '' }}" 
                       href="{{ path('admin_user_index') }}">
                        <i class="bi bi-people-fill"></i>
                        المستخدمون
                    </a>
                    {% endif %}

                    <hr class="sidebar-divider">
                    <div class="nav-section-title">الموقع العام</div>
                    
                    {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_content' ? 'active' : '' }}" 
                       href="{{ path('admin_content_index') }}">
                        <i class="bi bi-file-earmark-richtext-fill"></i>
                        المحتوى
                    </a>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_gallery' ? 'active' : '' }}" 
                       href="{{ path('admin_gallery_index') }}">
                        <i class="bi bi-images"></i>
                        المعرض
                    </a>
                    {% endif %}
                    
                    <hr class="sidebar-divider">
                    
                    <a class="nav-link {{ app.request.get('_route') == 'app_profile_edit' ? 'active' : '' }}" href="{{ path('app_profile_edit') }}">
                        <i class="bi bi-gear-fill"></i>
                        الإعدادات
                    </a>
                </nav>

                <div class="sidebar-footer">
                    <a class="btn btn-danger w-100 d-flex align-items-center justify-content-center py-2 shadow-sm" href="{{ path('app_logout') }}">
                        <i class="bi bi-box-arrow-right ms-2"></i>
                        تسجيل الخروج
                    </a>
                </div>
            </div>

            {# Main Content #}
            <div class="main-content">
                {# Flash Messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                            <i class="bi bi-info-circle-fill ms-2"></i>
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Page Content #}
                {% block body %}{% endblock %}
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>