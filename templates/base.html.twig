<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}جمعية حلم البراءة{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            direction: rtl;
            text-align: right;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            position: fixed;
            top: 0;
            right: 0;
            width: 250px;
            z-index: 1000;
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,.8);
            padding: 1rem 1.5rem;
            margin: 0.25rem 0.5rem;
            border-radius: 0.5rem;
            transition: all 0.3s;
            display: flex;
            align-items: center;
        }
        .sidebar .nav-link i {
            margin-left: 0.5rem;
            font-size: 1.2rem;
        }
        .sidebar .nav-link:hover, 
        .sidebar .nav-link.active {
            background: rgba(255,255,255,.2);
            color: #fff;
            transform: translateX(-5px);
        }
        .main-content {
            margin-right: 250px;
            padding: 2rem;
            min-height: 100vh;
            background: #f8f9fa;
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 2px 15px rgba(0,0,0,.1);
            margin-bottom: 1.5rem;
            transition: all 0.3s;
        }
        .card:hover {
            box-shadow: 0 5px 25px rgba(0,0,0,.15);
            transform: translateY(-5px);
        }
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .page-header {
            background: white;
            padding: 1.5rem;
            border-radius: 15px;
            margin-bottom: 2rem;
            box-shadow: 0 2px 15px rgba(0,0,0,.05);
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 0.5rem 1.5rem;
            border-radius: 8px;
            transition: all 0.3s;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }
        .sidebar-header {
            padding: 2rem 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }
        .sidebar-header h4 {
            margin: 0;
            font-weight: bold;
            display: flex;
            align-items: center;
        }
        .sidebar-header i {
            margin-left: 0.5rem;
            font-size: 1.5rem;
        }
        hr.sidebar-divider {
            border-color: rgba(255,255,255,.2);
            margin: 1rem 0;
        }
        .nav-section-title {
            color: rgba(255,255,255,.5);
            font-size: 0.75rem;
            text-transform: uppercase;
            padding: 0.5rem 1.5rem;
            margin-top: 1rem;
            font-weight: 600;
            letter-spacing: 1px;
        }
        .alert {
            border-radius: 10px;
            border: none;
        }
        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                position: relative;
                min-height: auto;
            }
            .main-content {
                margin-right: 0;
            }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            {# Sidebar #}
            <div class="sidebar">
                <div class="sidebar-header">
                    <h4>
                        <i class="bi bi-heart-pulse"></i>
                        حلم البراءة
                    </h4>
                    <small style="color: rgba(255,255,255,.6);">نظام إدارة الجمعية</small>
                </div>
                
                <nav class="nav flex-column py-3">
                    <a class="nav-link {{ app.request.get('_route') == 'app_dashboard' ? 'active' : '' }}" 
                       href="{{ path('app_dashboard') }}">
                        <i class="bi bi-speedometer2"></i>
                        لوحة القيادة
                    </a>
                    
                    <hr class="sidebar-divider">
                    <div class="nav-section-title">إدارة البيانات</div>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_beneficiaire' ? 'active' : '' }}" 
                       href="{{ path('app_beneficiaire_index') }}">
                        <i class="bi bi-people"></i>
                        المنتفعون
                    </a>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_famille' ? 'active' : '' }}" 
                       href="{{ path('app_famille_index') }}">
                        <i class="bi bi-house-heart"></i>
                        العائلات
                    </a>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_activite' ? 'active' : '' }}" 
                       href="{{ path('app_activite_index') }}">
                        <i class="bi bi-calendar-event"></i>
                        الأنشطة
                    </a>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_personnel' ? 'active' : '' }}" 
                       href="{{ path('app_personnel_index') }}">
                        <i class="bi bi-person-badge"></i>
                        الموظفون
                    </a>
                    
                   
                    <hr class="sidebar-divider">
                    <div class="nav-section-title">إدارة الموقع</div>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_content' ? 'active' : '' }}" 
                       href="{{ path('admin_content_index') }}">
                        <i class="bi bi-file-text"></i>
                        محتوى الصفحات
                    </a>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_gallery' ? 'active' : '' }}" 
                       href="{{ path('admin_gallery_index') }}">
                        <i class="bi bi-images"></i>
                        معرض الصور
                    </a>
                    
                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_donation' ? 'active' : '' }}" 
                       href="{{ path('admin_donation_index') }}">
                        <i class="bi bi-cash-stack"></i>
                        حملات التبرع
                    </a>
                    
                    
                    <hr class="sidebar-divider">
                    
                    <a class="nav-link" href="{{ path('app_logout') }}">
                        <i class="bi bi-box-arrow-right"></i>
                        تسجيل الخروج
                    </a>
                </nav>
            </div>

            {# Main Content #}
            <div class="main-content">
                {# Flash Messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            <i class="bi bi-{% if label == 'success' %}check-circle{% elseif label == 'danger' %}exclamation-triangle{% else %}info-circle{% endif %}"></i>
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Page Content #}
                {% block body %}{% endblock %}
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>