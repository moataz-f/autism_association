<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}جمعية حلم البراءة{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ===== Modern 2024 Design System ===== */
        :root {
            /* Colors */
            --primary: #2563EB;
            --primary-light: #60A5FA;
            --primary-dark: #1E40AF;
            --secondary: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
            
            /* Modern Neutrals (Slate) */
            --bg-body: #F8FAFC;
            --text-main: #0F172A;
            --text-muted: #64748B;
            --border-soft: rgba(226, 232, 240, 0.6);
            
            /* Structural (2026 Evolution) */
            --sidebar-width: 280px;
            --sidebar-bg: #0F111A; /* Deep Indigo Navy */
            --radius-bento: 28px;
            --radius-xl: 24px;
            --radius-lg: 18px;
            --radius-md: 12px;
            --border-micro: rgba(15, 23, 42, 0.04);
            
            /* Effects */
            --shadow-ambient: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
            --shadow-float: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
            --shadow-neo: 0 1px 2px rgba(0,0,0,0.02), 0 8px 24px rgba(0,0,0,0.02);
            --transition-smooth: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        /* ===== Global Reset & Typography ===== */
        body {
            direction: rtl;
            text-align: right;
            font-family: 'Tajawal', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            letter-spacing: -0.01em;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.025em;
        }

        /* ===== Fixed Premium Sidebar ===== */
        .sidebar {
            height: 100vh;
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            position: fixed;
            top: 0;
            right: 0;
            z-index: 1050;
            display: flex;
            flex-direction: column;
            box-shadow: 10px 0 30px rgba(0,0,0,0.05);
            border-left: 1px solid rgba(255,255,255,0.05);
        }

        .sidebar-header {
            padding: 2.5rem 1.5rem;
            flex-shrink: 0;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            color: white;
            text-decoration: none;
        }

        .sidebar-logo-img {
            width: 80px;
            height: 80px;
            object-fit: contain;
            transition: var(--transition-smooth);
        }
        
        .sidebar-brand:hover .sidebar-logo-img {
            transform: scale(1.1) rotate(-5deg);
        }

        .sidebar-brand h4 {
            margin: 0;
            color: white;
            font-size: 1.2rem;
            font-weight: 800;
        }

        .sidebar-brand small {
            color: #94A3B8;
            font-size: 0.75rem;
            display: block;
            margin-top: 2px;
        }

        /* Navigation Links */
        .nav-wrapper {
            flex-grow: 1;
            padding: 0.25rem 0.75rem;
            overflow-y: auto; /* Re-enable scroll */
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none; /* IE/Edge */
        }
        .nav-wrapper::-webkit-scrollbar { display: none; } /* Chrome/Safari */

        .nav-section-label {
            color: #475569;
            font-size: 0.65rem;
            font-weight: 800;
            text-transform: uppercase;
            padding: 1rem 1rem 0.4rem;
            letter-spacing: 0.1em;
        }

        .nav-link {
            display: flex;
            align-items: center;
            color: #94A3B8;
            padding: 0.85rem 1rem;
            margin-bottom: 0.25rem;
            border-radius: 16px;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition-smooth);
        }

        /* Complex Navigation Link with Subtitle */
        .nav-link.complex {
            padding: 1rem;
            align-items: flex-start;
        }

        .nav-link.complex .link-info {
            display: flex;
            flex-direction: column;
        }

        .nav-link.complex .sub {
            font-size: 0.75rem;
            font-weight: 500;
            opacity: 0.6;
            margin-top: 2px;
            display: block;
        }

        .nav-link i {
            font-size: 1.25rem;
            margin-left: 12px;
            color: #475569;
            transition: color 0.3s ease;
        }

        .nav-link:hover {
            background: rgba(255,255,255,0.05);
            color: white;
        }

        .nav-link:hover i {
            color: var(--primary-light);
        }

        .nav-link.active {
            background: rgba(37, 99, 235, 0.1);
            color: var(--primary-light);
            position: relative;
        }

        .nav-link.active::after {
            content: '';
            position: absolute;
            right: 0;
            top: 20%;
            bottom: 20%;
            width: 4px;
            background: var(--primary);
            border-radius: 4px 0 0 4px;
        }

        .nav-link.active i {
            color: var(--primary-light);
        }

        /* Sidebar Footer & User Profile */
        .sidebar-footer {
            padding: 1rem;
            border-top: 1px solid rgba(255,255,255,0.05);
            flex-shrink: 0;
            background: rgba(0,0,0,0.25);
        }

        .user-pill {
            display: flex;
            align-items: center;
            padding: 0.6rem;
            background: rgba(255,255,255,0.03);
            border-radius: 12px;
            margin-bottom: 0.75rem;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .user-pill .user-info {
            display: flex;
            flex-direction: column;
            margin-right: 10px;
            overflow: hidden;
            width: 100%;
        }

        .user-pill .u-name {
            color: white;
            font-size: 0.8rem;
            font-weight: 700;
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
        }

        .user-pill .u-role {
            color: #64748B;
            font-size: 0.65rem;
            font-weight: 500;
        }

        .footer-actions {
            display: flex;
            gap: 4px;
        }

        .footer-btn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0.5rem;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: 700;
            text-decoration: none;
            transition: var(--transition-smooth);
            background: rgba(255,255,255,0.05);
            color: #94A3B8;
        }

        .footer-btn:hover {
            background: rgba(255,255,255,0.1);
            color: white;
        }

        .footer-btn.logout {
            color: #F87171;
            background: rgba(239, 68, 68, 0.05);
        }

        .footer-btn.logout:hover {
            background: var(--danger);
            color: white;
        }

        /* ===== Main Layout ===== */
        .main-content {
            margin-right: var(--sidebar-width);
            padding: 2.5rem;
            min-height: 100vh;
            width: calc(100% - var(--sidebar-width));
        }

        /* ===== Modern Components ===== */
        .card {
            background: white;
            border: 1px solid var(--border-soft);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-ambient);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .card:hover {
            box-shadow: var(--shadow-float);
            transform: translateY(-4px);
        }

        .card-body {
            padding: 2rem;
        }

        /* Page Header */
        .page-header {
            margin-bottom: 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: white;
            padding: 1.5rem 2rem;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-soft);
            box-shadow: var(--shadow-ambient);
        }

        .page-title h2 {
            font-size: 1.5rem;
            margin: 0;
            font-weight: 800;
        }

        /* Buttons (Sleek) */
        .btn {
            border-radius: 10px;
            padding: 0.6rem 1.25rem;
            font-weight: 700;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: var(--primary);
            border: none;
            color: white;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
        }

        /* 2026 Signature Components */
        .avatar-sq {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 1rem;
            transition: var(--transition-smooth);
        }

        .badge-2026 {
            padding: 0.4rem 0.8rem;
            border-radius: 10px;
            font-weight: 800;
            font-size: 0.75rem;
            letter-spacing: 0.02em;
        }

        .action-btn-2026 {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            background: white;
            color: var(--primary);
            border: 1px solid var(--border-micro);
            transition: var(--transition-smooth);
        }
        .action-btn-2026:hover { background: var(--primary); color: white; border-color: var(--primary); transform: translateY(-3px); }

        /* Status Colors */
        .bg-primary { background-color: var(--primary) !important; color: white !important; }
        .bg-secondary { background-color: var(--secondary) !important; color: white !important; }
        .bg-warning { background-color: var(--warning) !important; color: black !important; }
        .bg-danger { background-color: var(--danger) !important; color: white !important; }

        @media (max-width: 992px) {
            .sidebar { transform: translateX(100%); transition: transform 0.3s ease; }
            .sidebar.active { transform: translateX(0); }
            .main-content { margin-right: 0; width: 100%; padding: 1.5rem; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="container-fluid p-0">
        {# Sidebar #}
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="{{ path('app_dashboard') }}" class="sidebar-brand">
                    <img src="{{ asset('assets/images/logo-v2.jpg') }}" alt="Logo" class="sidebar-logo-img ms-3">
                    <div>
                        <h4>حلم البراءة</h4>
                        <small>Association Autism</small>
                    </div>
                </a>
            </div>
            
            <div class="nav-wrapper">
                <nav class="nav flex-column">
                    <a class="nav-link {{ app.request.get('_route') == 'app_dashboard' ? 'active' : '' }}" href="{{ path('app_dashboard') }}">
                        <i class="bi bi-grid-fill"></i> لوحة القيادة
                    </a>

                    {% if app.user and not is_granted('ROLE_PARENT') %}
                    <a class="nav-link {{ app.request.get('_route') == 'app_pointage_scan' ? 'active' : '' }}" href="{{ path('app_pointage_scan') }}">
                        <i class="bi bi-camera-fill"></i> تسجيل الحضور
                    </a>
                    {% endif %}
                    
                    <div class="nav-section-label">الإدارة</div>
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_beneficiaire' ? 'active' : '' }}" href="{{ path('app_beneficiaire_index') }}">
                        <i class="bi bi-person-fill"></i> المنتفعون
                    </a>
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_famille' ? 'active' : '' }}" href="{{ path('app_famille_index') }}">
                        <i class="bi bi-house-fill"></i> العائلات
                    </a>
                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_donation_index' ? 'active' : '' }}" href="{{ path('admin_donation_index') }}">
                        <i class="bi bi-gift-fill"></i> حملات التبرع
                    </a>
                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_donation_request' ? 'active' : '' }}" href="{{ path('admin_donation_request_index') }}">
                        <i class="bi bi-heart-fill"></i> طلبات التبرع
                    </a>
                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_seance' ? 'active' : '' }}" href="{{ path('admin_seance_index') }}">
                        <i class="bi bi-calendar-event"></i> الجدولة
                    </a>

                    {% if is_granted('ROLE_ADMIN') %}
                    <a class="nav-link complex {{ app.request.get('_route') starts with 'admin_pointage' ? 'active' : '' }}" href="{{ path('admin_pointage_index') }}">
                        <i class="bi bi-clock-history"></i>
                        <div class="link-info">
                            <span>سجل الحضور</span>
                            <span class="sub">متابعة الغياب والتأخير</span>
                        </div>
                    </a>
                    <a class="nav-link complex" href="{{ path('admin_pointage_print_daily') }}" target="_blank">
                        <i class="bi bi-qr-code-scan"></i>
                        <div class="link-info">
                            <span>طباعة رموز اليوم</span>
                            <span class="sub">فتح واجهة الرموز اليومية</span>
                        </div>
                    </a>
                    {% endif %}

                    <div class="nav-section-label">النشر الرقمي</div>
                    <a class="nav-link complex {{ app.request.get('_route') starts with 'admin_content' ? 'active' : '' }}" href="{{ path('admin_content_index') }}">
                        <i class="bi bi-pencil-square"></i>
                        <div class="link-info">
                            <span>محتوى الصفحات</span>
                            <span class="sub">إدارة النصوص والروابط</span>
                        </div>
                    </a>
                    <a class="nav-link complex {{ app.request.get('_route') starts with 'admin_gallery' ? 'active' : '' }}" href="{{ path('admin_gallery_index') }}">
                        <i class="bi bi-images"></i>
                        <div class="link-info">
                            <span>معرض الصور</span>
                            <span class="sub">تحديث ألبوم الجمعية</span>
                        </div>
                    </a>
                    <a class="nav-link complex {{ app.request.get('_route') starts with 'admin_actualite' ? 'active' : '' }}" href="{{ path('admin_actualite_index') }}">
                        <i class="bi bi-newspaper"></i>
                        <div class="link-info">
                            <span>الأخبار</span>
                            <span class="sub">نشر المستجدات</span>
                        </div>
                    </a>
                    <a class="nav-link complex {{ app.request.get('_route') starts with 'admin_page' ? 'active' : '' }}" href="{{ path('admin_page_index') }}">
                        <i class="bi bi-file-earmark-text"></i>
                        <div class="link-info">
                            <span>الصفحات الثابتة</span>
                            <span class="sub">إدارة محتوى الصفحات</span>
                        </div>
                    </a>

                    {% if is_granted('ROLE_ADMIN') %}
                    <div class="nav-section-label">النظام</div>
                    <a class="nav-link {{ app.request.get('_route') starts with 'app_personnel' ? 'active' : '' }}" href="{{ path('app_personnel_index') }}">
                        <i class="bi bi-people-fill"></i> الفريق
                    </a>
                    <a class="nav-link {{ app.request.get('_route') starts with 'admin_user' ? 'active' : '' }}" href="{{ path('admin_user_index') }}">
                        <i class="bi bi-shield-lock-fill"></i> الصلاحيات
                    </a>
                    {% endif %}
                </nav>
            </div>

            <div class="sidebar-footer">
                {% if app.user %}
                <div class="user-pill">
                    <div class="avatar-sq" style="width: 28px; height: 28px; font-size: 0.7rem; background: var(--primary); color: white; border-radius: 8px;">
                        {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                    </div>
                    <div class="user-info">
                        <span class="u-name">{{ app.user.prenom }} {{ app.user.nom }}</span>
                        <span class="u-role">Email: {{ app.user.email }}</span>
                    </div>
                </div>
                {% endif %}

                <div class="footer-actions">
                    <a href="{{ path('app_profile_edit') }}" class="footer-btn" title="الإعدادات">
                        <i class="bi bi-gear-fill"></i>
                        <span>الإعدادات</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="footer-btn logout" title="خروج">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>خروج</span>
                    </a>
                </div>
            </div>
        </aside>

        {# Main Content #}
        <main class="main-content">
            <div class="container-fluid p-0">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show rounded-16 border-0 shadow-sm mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-{{ label == 'error' ? 'exclamation-triangle' : 'check-circle' }}-fill ms-2"></i>
                                <div>{{ message }}</div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
            {% block body %}{% endblock %}
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>