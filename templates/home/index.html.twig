{% extends 'base_public.html.twig' %}

{% block title %}جمعية حلم البراءة بقبلي للتوحد{% endblock %}

{% block extra_css %}
    <style>
        /* Hero 2026 - Animated Liquid Version */
        .hero {
            position: relative;
            min-height: 90vh;
            display: flex;
            align-items: center;
            padding: 120px 0;
            background: linear-gradient(-45deg, #FDFBFA, #F1F4FF, #E6FFFA, #FDFBFA);
            background-size: 400% 400%;
            animation: liquidGradient 15s ease infinite;
            overflow: hidden;
        }

        @keyframes liquidGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        
        /* Floating Bubbles / Shapes for depth */
        .hero::before, .hero::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(142, 151, 253, 0.1) 0%, transparent 70%);
            animation: float 20s infinite alternate;
            pointer-events: none;
            z-index: 1;
        }
        .hero::before { top: -100px; right: -100px; animation-duration: 25s; }
        .hero::after { bottom: -100px; left: -100px; animation-duration: 30s; animation-delay: -5s; }

        @keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(100px, 50px) scale(1.1); }
        }

        /* Gradient Transition to Body */
        .hero-transition {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 150px;
            background: linear-gradient(to bottom, transparent, var(--bg-body));
            z-index: 3;
            pointer-events: none;
        }

        .hero-content-wrapper {
            position: relative;
            z-index: 2;
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(12px);
            padding: 4rem;
            border-radius: var(--radius-bento);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 20px 40px rgba(0,0,0,0.02);
            max-width: 900px;
            margin: 0 auto;
        }

        .hero-title {
            font-size: clamp(2.5rem, 8vw, 4.5rem);
            font-weight: 900;
            line-height: 1.1;
            color: var(--navy);
            margin-bottom: 1.5rem;
            letter-spacing: -0.04em;
        }

        .hero-sub {
            font-size: 1.25rem;
            color: var(--text-muted);
            max-width: 600px;
            margin-bottom: 2.5rem;
            font-weight: 500;
        }

        /* Bento Islands */
        .bento-card {
            background: white;
            border-radius: var(--radius-bento);
            padding: 2.5rem;
            border: 1px solid var(--border-micro);
            box-shadow: var(--shadow-neo);
            height: 100%;
            transition: var(--transition-smooth);
        }
        .bento-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.04); }

        /* Gallery Bento Grid */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-gap: 20px;
            margin-top: 50px;
        }
        .gallery-item {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            height: 300px;
            cursor: pointer;
        }
        .gallery-item:nth-child(1) { grid-column: span 2; grid-row: span 2; height: 620px; }
        .gallery-item:nth-child(2) { grid-column: span 2; }
        .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: var(--transition-smooth); }
        .gallery-item:hover img { transform: translateY(-5px); }

        .gallery-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 2rem;
            background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
            color: white;
            opacity: 0;
            transition: var(--transition-smooth);
        }
        .gallery-item:hover .gallery-info { opacity: 1; }

        /* Donation Island */
        .donation-island {
            background: #F1F4FF;
            border-radius: 40px;
            padding: 4rem;
            color: var(--text-main);
            position: relative;
            overflow: hidden;
            margin: 100px 0;
            border: 1px solid rgba(142, 151, 253, 0.1);
        }
        .donation-island::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -10%;
            width: 70%;
            height: 200%;
            background: radial-gradient(circle, rgba(142, 151, 253, 0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .progress-slim {
            height: 10px;
            background: rgba(142, 151, 253, 0.1);
            border-radius: 10px;
            margin: 2rem 0;
            overflow: hidden;
        }
        .progress-bar-2026 {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--primary-light));
            border-radius: 10px;
        }

        /* Buttons 2026 */
        .btn-2026-hero {
            padding: 1rem 2.5rem;
            border-radius: 18px;
            font-weight: 800;
            font-size: 1rem;
            transition: var(--transition-smooth);
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            background: var(--navy); 
            color: white; 
            border: none;
        }
        .btn-2026-hero-light { background: white; color: var(--navy); }
        .btn-2026-hero:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }

        .bg-light-2026 { background-color: #F8FAFC; }

        @media (max-width: 992px) {
            .gallery-grid { grid-template-columns: repeat(2, 1fr); }
            .gallery-item:nth-child(1) { height: 300px; grid-column: span 1; grid-row: span 1; }
        }
    </style>
{% endblock %}

{% block body %}
    <header id="home" class="hero">
        <canvas id="hero-canvas" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;"></canvas>
        <div class="hero-transition"></div>
        <div class="container text-center">
            <div class="hero-content-wrapper animate__animated animate__fadeInUp">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill mb-4 fw-800">
                    جمعية حلم البراءة للتوحد بقبلي
                </span>
                <h1 class="hero-title">
                    {{ heroContent ? heroContent.titre : 'نصنع الأمل،' }}<br>
                    <span class="text-primary">{{ heroContent ? heroContent.sousTitre : 'نحقق الأحلام' }}</span>
                </h1>
                <p class="hero-sub mx-auto">
                    {{ heroContent ? heroContent.description : 'جمعية متخصصة تهتم برعاية وتأهيل الأطفال ذوي اضطراب التوحد، نسعى لتوفير بيئة تعليمية دافئة ومبتكرة.' }}
                </p>
                <div class="d-flex gap-3 justify-content-center">
                    <a href="{{ path('app_gallery_index') }}" class="btn-2026-hero btn-2026-hero-light border">استكشف برامجنا</a>
                    <a href="{{ path('app_donation_index') }}" class="btn-2026-hero"><i class="bi bi-heart-fill ms-1"></i> تبرع الآن</a>
                </div>
            </div>
        </div>
    </header>

    <section id="gallery" class="py-5">
        <div class="container">
            <div class="row align-items-center mb-5">
                <div class="col-lg-6">
                    <h2 style="font-weight: 900; font-size: 2.5rem; color: var(--navy);">معرض الصور</h2>
                    <p class="text-muted fw-500">مشاهد من أنشطة أطفالنا وحياتهم اليومية في الجمعية</p>
                </div>
                <div class="col-lg-6 text-lg-start">
                    <a href="{{ path('app_gallery_index') }}" class="text-primary fw-800 text-decoration-none">مشاهدة الكل <i class="bi bi-arrow-left"></i></a>
                </div>
            </div>

            <div class="gallery-grid">
                {% for image in galleryImages %}
                <div class="gallery-item">
                    <img src="{{ vich_uploader_asset(image, 'imageFile') }}" alt="{{ image.titre }}">
                    <div class="gallery-info">
                        <h5 class="fw-800 mb-0">{{ image.titre }}</h5>
                        <small class="opacity-75">{{ image.description }}</small>
                    </div>
                </div>
                {% else %}
                <div class="col-12 text-center py-5">
                    <i class="bi bi-images text-muted opacity-25" style="font-size: 4rem;"></i>
                    <p class="text-muted mt-3">سيتم إضافة الصور قريباً</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="news" class="py-5 bg-light-2026">
        <div class="container">
            <div class="row align-items-center mb-5">
                <div class="col-lg-6">
                    <h2 class="fw-900 text-navy" style="font-size: 2.5rem;">آخر الأخبار</h2>
                    <p class="text-muted fw-500">تابعوا مستجدات وفعاليات جمعية حلم البراءة</p>
                </div>
                <div class="col-lg-6 text-lg-start">
                    <a href="{{ path('app_actualite_index') }}" class="text-primary fw-800 text-decoration-none">مشاهدة جميع الأخبار <i class="bi bi-arrow-left"></i></a>
                </div>
            </div>

            <div class="row g-4">
                {% for item in news %}
                    <div class="col-lg-4">
                        <div class="bento-card p-0 overflow-hidden border-0">
                            {% if item.imagePath %}
                                <img src="{{ vich_uploader_asset(item, 'imageFile') }}" class="w-100" style="height: 240px; object-fit: cover;">
                            {% else %}
                                <div class="bg-light-2026 d-flex align-items-center justify-content-center" style="height: 240px;">
                                    <i class="bi bi-newspaper text-muted opacity-25" style="font-size: 3rem;"></i>
                                </div>
                            {% endif %}
                            <div class="p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill fw-800 px-3 py-2 small">مستجدات</span>
                                    <small class="text-muted fw-700">{{ item.createdAt|date('Y/m/d') }}</small>
                                </div>
                                <h5 class="fw-800 text-navy mb-3">{{ item.titre }}</h5>
                                <p class="text-muted small lh-lg mb-4">{{ item.description|length > 100 ? item.description|slice(0, 100) ~ '...' : item.description }}</p>
                                <a href="{{ path('app_actualite_show', {slug: item.slug}) }}" class="btn btn-navy-hero btn-2026-hero-light border w-100 justify-content-center py-2" style="border-radius: 14px; text-decoration: none; color: inherit; display: flex;">اقرأ المزيد</a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-5">
                        <p class="text-muted fw-800">لا توجد أخبار منشورة حالياً.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {% if mainCampaign %}
    <section id="donate" class="container">
        <div class="donation-island">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <div class="mb-4 d-flex align-items-center gap-3">
                        <i class="bi bi-heart-fill text-primary" style="font-size: 2.5rem;"></i>
                        <h2 class="fw-900 mb-0" style="font-size: 3rem; color: var(--navy);">شارك في صنع التغيير</h2>
                    </div>
                    <h3 class="fw-800 text-primary mb-4">{{ mainCampaign.titre }}</h3>
                    <p class="lead opacity-75 mb-5 lh-lg" style="font-weight: 500;">
                        {{ mainCampaign.description }}
                    </p>
                    
                    {% if is_granted('ROLE_ADMIN') %}
                    <div class="d-flex align-items-end gap-3 mb-2">
                        <div style="font-size: 3.5rem; font-weight: 900; color: var(--navy);">{{ mainCampaign.montantCollecte|number_format(0, '.', ',') }}</div>
                        <div class="mb-3 opacity-50 fw-800">من {{ mainCampaign.montantObjectif|number_format(0, '.', ',') }} دينار</div>
                    </div>

                    <div class="progress-slim">
                        <div class="progress-bar-2026" style="width: {{ mainCampaign.pourcentage }}%"></div>
                    </div>
                    
                    <div class="d-flex justify-content-between fw-800 mb-5">
                        <span class="text-primary">نسبة الإنجاز: {{ mainCampaign.pourcentage }}%</span>
                        <span class="opacity-50">عدد المتبرعين: 124+</span>
                    </div>
                    {% else %}
                        <div class="mb-5"></div>
                    {% endif %}

                    {% if mainCampaign.isFilled %}
                        <div class="alert alert-success rounded-4 fw-bold text-center py-3">
                            <i class="bi bi-patch-check-fill me-2"></i> لقد حققت هذه الحملة هدفها بنجاح! شكراً لكل المتبرعين.
                        </div>
                    {% else %}
                        <a href="{{ path('app_donation_request', {'campaign': mainCampaign.id}) }}" class="btn-2026-hero py-3 px-5">تبرع الآن <i class="bi bi-credit-card ms-2"></i></a>
                    {% endif %}
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="bento-card border-0 bg-opacity-10 bg-white p-5 text-center">
                        <img src="{{ asset('assets/images/logo-v2.jpg') }}" alt="Donation Icon" style="width: 150px; opacity: 0.9; border-radius: 20px;">
                    </div>
                </div>
            </div>
        </div>
    </section>
    {% endif %}
{% endblock %}

{% block extra_js %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js"></script>
    <script>
        // Three.js 3D Background Implementation
        const canvas = document.querySelector('#hero-canvas');
        if (canvas) {
            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            
            camera.position.z = 5;

            // Soft Lighting
            const light = new THREE.DirectionalLight(0xffffff, 2);
            light.position.set(1, 1, 2);
            scene.add(light);
            scene.add(new THREE.AmbientLight(0xffffff, 1));

            // Create Soft Spheres
            const spheres = [];
            const geometry = new THREE.IcosahedronGeometry(1, 15);
            
            // Soft Pastel Palette
            const colors = [0x8E97FD, 0xA8E6CF, 0xFFD3B6, 0xD4A5A5];
            
            for(let i = 0; i < 8; i++) {
                const material = new THREE.MeshPhongMaterial({
                    color: colors[i % colors.length],
                    shininess: 100,
                    transparent: true,
                    opacity: 0.6
                });
                const sphere = new THREE.Mesh(geometry, material);
                
                sphere.position.set(
                    (Math.random() - 0.5) * 12,
                    (Math.random() - 0.5) * 8,
                    (Math.random() - 0.5) * 4
                );
                
                const scale = 0.5 + Math.random() * 1.5;
                sphere.scale.set(scale, scale, scale);
                
                sphere.userData = {
                    rotateSpeed: (Math.random() - 0.5) * 0.01,
                    floatSpeed: (Math.random() - 0.5) * 0.005,
                    originalY: sphere.position.y
                };
                
                scene.add(sphere);
                spheres.push(sphere);
            }

            // Mouse Interaction
            let mouseX = 0, mouseY = 0;
            window.addEventListener('mousemove', (e) => {
                mouseX = (e.clientX - window.innerWidth / 2) * 0.001;
                mouseY = (e.clientY - window.innerHeight / 2) * 0.001;
            });

            function animate() {
                requestAnimationFrame(animate);
                
                spheres.forEach(s => {
                    s.rotation.x += s.userData.rotateSpeed;
                    s.rotation.y += s.userData.rotateSpeed;
                    s.position.y = s.userData.originalY + Math.sin(Date.now() * 0.001 + s.position.x) * 0.2;
                    
                    // Subtle Mouse Reactivity
                    s.position.x += (mouseX * 2 - s.position.x * 0.05) * 0.05;
                    s.position.y += (-mouseY * 2 - s.position.y * 0.05) * 0.05;
                });

                renderer.render(scene, camera);
            }

            function resize() {
                const width = canvas.clientWidth;
                const height = canvas.clientHeight;
                camera.aspect = width / height;
                camera.updateProjectionMatrix();
                renderer.setSize(width, height, false); // false to not set CSS width
            }

            window.addEventListener('resize', resize);
            resize();
            animate();
        }
    </script>
{% endblock %}