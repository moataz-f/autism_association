<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}جمعية حلم البراءة بقبلي للتوحد{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #8E97FD;
            --primary-light: #C2C9FF;
            --secondary: #A8E6CF;
            --navy: #3D4451;
            --bg-body: #FDFBFA;
            --text-main: #4A4E69;
            --text-muted: #9A9EAB;
            --border-micro: rgba(74, 78, 105, 0.06);
            --radius-bento: 32px;
            --shadow-neo: 0 4px 20px rgba(0,0,0,0.03);
            --transition-smooth: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            direction: rtl;
        }

        .navbar {
            backdrop-filter: blur(12px);
            background: rgba(255, 255, 255, 0.82);
            border-bottom: 1px solid var(--border-micro);
            padding: 1rem 0;
            z-index: 1000;
        }

        .nav-link {
            color: var(--text-main) !important;
            font-weight: 700;
            font-size: 0.95rem;
            margin: 0 0.75rem;
            transition: var(--transition-smooth);
        }

        .nav-link:hover { color: var(--primary) !important; }

        .btn-2026 {
            background: var(--navy);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 14px;
            font-weight: 800;
            text-decoration: none;
            transition: var(--transition-smooth);
        }

        .btn-2026:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); color: white; }

        .footer {
            background: var(--navy);
            padding: 80px 0 40px;
            color: #94A3B8;
            margin-top: 100px;
        }

        .card-2026 {
            background: white;
            border-radius: 24px;
            border: 1px solid var(--border-micro);
            box-shadow: var(--shadow-neo);
            transition: var(--transition-smooth);
        }

        {% block extra_css %}{% endblock %}
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="{{ path('app_home') }}">
                <img src="{{ asset('assets/images/logo-v2.jpg') }}" alt="Logo" style="height: 40px;" class="ms-2">
                <span style="font-weight: 900; color: var(--navy);">حلم البراءة بقبلي</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class="bi bi-list fs-2"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">الرئيسية</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_page_index') }}">عن الجمعية</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_gallery_index') }}">معرض الصور</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_actualite_index') }}">الأخبار والأحداث</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_donation_index') }}">التبرعات</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_contact') }}">اتصل بنا</a></li>
                    
                    {% if app.user %}
                        <li class="nav-item ms-lg-4">
                            <a class="btn-2026 bg-primary" href="{{ path('app_dashboard') }}">لوحة التحكم</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right"></i></a>
                        </li>
                    {% else %}
                        <li class="nav-item ms-lg-4">
                            <a class="nav-link fw-800" href="{{ path('app_register') }}">إنشاء حساب</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn-2026" href="{{ path('app_login') }}">دخول النظام</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-5">
                    <h4 class="text-white fw-900 mb-4">حلم البراءة بقبلي</h4>
                    <p class="lh-lg">جمعية تونسية متخصصة في رعاية وتأهيل الأطفال ذوي اضطراب التوحد، نؤمن بأن كل طفل يستحق فرصة للتألق والاندماج في المجتمع.</p>
                </div>
                <div class="col-lg-3">
                    <h5 class="text-white fw-800 mb-4">روابط سريعة</h5>
                    <a href="{{ path('app_home') }}" class="d-block mb-2 text-decoration-none text-muted">الرئيسية</a>
                    <a href="{{ path('app_gallery_index') }}" class="d-block mb-2 text-decoration-none text-muted">معرض الصور</a>
                    <a href="{{ path('app_actualite_index') }}" class="d-block mb-2 text-decoration-none text-muted">الأخبار</a>
                </div>
                <div class="col-lg-4">
                    <h5 class="text-white fw-800 mb-4">تواصل معنا</h5>
                    <p><i class="bi bi-geo-alt ms-2"></i> قبلي، تونس</p>
                    <p dir="ltr" class="text-end"><i class="bi bi-telephone ms-2"></i> +216 12 345 678</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block extra_js %}{% endblock %}
</body>
</html>
