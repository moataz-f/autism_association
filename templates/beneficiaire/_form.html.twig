{{ form_start(form) }}
<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_row(form.nom) }}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_row(form.prenom) }}
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_row(form.dateNaissance) }}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_row(form.genre) }}
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_row(form.telephone) }}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_row(form.niveauAutisme) }}
    </div>
</div>
<div class="mb-3">
    {{ form_row(form.adresse) }}
</div>
<div class="mb-3">
    {{ form_row(form.diagnostic) }}
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_row(form.famille) }}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_row(form.actif) }}
    </div>
</div>
<div class="text-center">
    <button type="submit" class="btn btn-primary btn-lg">
        <i class="bi bi-save"></i> {{ button_label|default('حفظ') }}
    </button>
</div>
{{ form_end(form) }}