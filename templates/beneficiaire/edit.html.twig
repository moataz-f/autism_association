{% extends 'base.html.twig' %}

{% block title %}تعديل بيانات المنتفع{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-0">تعديل بيانات الطفل: {{ beneficiaire.prenom }} {{ beneficiaire.nom }}</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">لوحة القيادة</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_beneficiaire_index') }}">المنتفعون</a></li>
                <li class="breadcrumb-item active">تعديل</li>
            </ol>
        </nav>
    </div>
    <a href="{{ path('app_beneficiaire_index') }}" class="btn btn-light">
        <i class="bi bi-arrow-right"></i> العودة للقائمة
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                {{ include('beneficiaire/_form.html.twig', {'button_label': 'تحديث بيانات الطفل'}) }}
            </div>
        </div>

        <div class="card shadow-sm border-0 border-top-danger" style="border-top: 3px solid #FCA5A5 !important;">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="text-danger mb-1">منطقة خطرة</h5>
                    <p class="text-muted mb-0 small">حذف الطفل سيؤدي إلى إزالة كافة بياناته من النظام بشكل نهائي.</p>
                </div>
                {{ include('beneficiaire/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}