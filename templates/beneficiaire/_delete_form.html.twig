<form method="post" action="{{ path('app_beneficiaire_delete', {'id': beneficiaire.id}) }}" onsubmit="return confirm('هل أنت متأكد من تعطيل هذا المنتفع؟');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ beneficiaire.id) }}">
    <button class="btn btn-danger">
        <i class="bi bi-x-circle"></i> تعطيل المنتفع
    </button>
</form>