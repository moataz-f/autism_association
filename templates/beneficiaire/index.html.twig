{% extends 'base.html.twig' %}

{% block title %}إدارة المنتفعين{% endblock %}

{% block body %}
<div class="page-header justify-content-between">
    <div class="page-title">
        <h2>قائمة الأطفال المنتفعين</h2>
        <p>إدارة بيانات ومتابعة الأطفال المسجلين في الجمعية</p>
    </div>
    <a href="{{ path('app_beneficiaire_new') }}" class="btn btn-primary">
        <i class="bi bi-person-plus-fill ms-2"></i> إضافة طفل جديد
    </a>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead>
                    <tr>
                        <th class="text-end ps-4" style="width: 30%;">الطفل</th>
                        <th>تاريخ الميلاد</th>
                        <th>المستوى</th>
                        <th>الأولياء</th>
                        <th>الحالة</th>
                        <th class="text-start pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                {% for beneficiaire in pagination %}
                    <tr>
                        <td class="text-end ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-sq ms-3" style="background: rgba(37, 99, 235, 0.08); color: var(--primary);">
                                    {{ beneficiaire.prenom|first|upper }}{{ beneficiaire.nom|first|upper }}
                                </div>
                                <div>
                                    <div class="fw-800 text-main">{{ beneficiaire.prenom }} {{ beneficiaire.nom }}</div>
                                    <small class="text-muted fw-600">السن: {{ beneficiaire.age }} سنة</small>
                                </div>
                            </div>
                        </td>
                        <td class="fw-600">{{ beneficiaire.dateNaissance|date('Y-m-d') }}</td>
                        <td>
                            {% set level_color = 'primary' %}
                            {% if beneficiaire.niveauAutisme == 'Modéré' %}{% set level_color = 'warning' %}
                            {% elseif beneficiaire.niveauAutisme == 'Sévère' %}{% set level_color = 'danger' %}
                            {% endif %}
                            <span class="badge-2026" style="background: var(--{{ level_color == 'primary' ? 'primary' : level_color }})0D; color: var(--{{ level_color == 'primary' ? 'primary' : level_color }});">
                                {{ beneficiaire.niveauAutisme }}
                            </span>
                        </td>
                        <td class="fw-700 text-muted">{{ beneficiaire.parents|length }} وليّ أمر</td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <span class="dot-indicator bg-{{ beneficiaire.actif ? 'secondary' : 'muted' }} ms-2"></span>
                                <span class="fw-700 {{ beneficiaire.actif ? 'text-secondary' : 'text-muted' }}">
                                    {{ beneficiaire.actif ? 'نشط' : 'موجه' }}
                                </span>
                            </div>
                        </td>
                        <td class="text-start pe-4">
                            <div class="d-flex gap-2 justify-content-start">
                                <a href="{{ path('app_beneficiaire_show', {'id': beneficiaire.id}) }}" class="action-btn-2026" title="عرض">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_beneficiaire_edit', {'id': beneficiaire.id}) }}" class="action-btn-2026" style="color: var(--secondary); border-color: rgba(16, 185, 129, 0.1);" title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="empty-state">
                                <i class="bi bi-people text-muted opacity-25" style="font-size: 4rem;"></i>
                                <p class="text-muted mt-3 fw-600">لا يوجد أطفال مسجلون حالياً.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div class="py-4 px-4 d-flex justify-content-center border-top">
            {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
        </div>
    </div>
</div>

<style>
    .fw-800 { font-weight: 800; }
    .fw-700 { font-weight: 700; }
    .fw-600 { font-weight: 600; }
    
    .dot-indicator {
        height: 8px;
        width: 8px;
        border-radius: 50%;
        display: inline-block;
    }
    
    th { font-weight: 800 !important; color: var(--text-muted) !important; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; }
</style>
{% endblock %}