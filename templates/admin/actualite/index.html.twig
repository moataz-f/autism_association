{% extends 'base.html.twig' %}

{% block title %}إدارة الأخبار{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-800 text-navy"><i class="bi bi-newspaper"></i> إدارة الأخبار والمستجدات</h2>
    <a href="{{ path('admin_actualite_new') }}" class="btn btn-2026-primary">
        <i class="bi bi-plus-circle ms-1"></i> إضافة خبر جديد
    </a>
</div>

<div class="card card-2026 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light-2026">
                    <tr>
                        <th class="ps-4">الخبر</th>
                        <th>الحالة</th>
                        <th>تاريخ النشر</th>
                        <th class="text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    {% for actualite in actualites %}
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                {% if actualite.imagePath %}
                                    <img src="{{ vich_uploader_asset(actualite, 'imageFile') }}" class="rounded-16" style="width: 60px; height: 60px; object-fit: cover;">
                                {% else %}
                                    <div class="bg-light-2026 rounded-16 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                {% endif %}
                                <div>
                                    <h6 class="fw-800 text-navy mb-0">{{ actualite.titre }}</h6>
                                    <small class="text-muted">{{ actualite.description|length > 50 ? actualite.description|slice(0, 50) ~ '...' : actualite.description }}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if actualite.actif %}
                                <span class="badge-2026 bg-success">نشط</span>
                            {% else %}
                                <span class="badge-2026 bg-secondary">مسودة</span>
                            {% endif %}
                        </td>
                        <td>{{ actualite.createdAt|date('Y/m/d') }}</td>
                        <td class="text-center pe-4">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('admin_actualite_edit', {id: actualite.id}) }}" class="action-btn-2026">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('admin_actualite_delete', {id: actualite.id}) }}" style="display:inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا الخبر؟');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ actualite.id) }}">
                                    <button class="action-btn-2026 text-danger" style="background: #FFF5F5; border-color: #FED7D7;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <i class="bi bi-newspaper text-muted opacity-25" style="font-size: 4rem;"></i>
                            <p class="text-muted mt-3 fw-800">لا توجد أخبار حالياً</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
