<form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذا المستخدم؟');" style="display: inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-sm btn-outline-danger" title="حذف">
        <i class="bi bi-trash"></i>
    </button>
</form>
