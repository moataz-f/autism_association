{% extends 'base.html.twig' %}

{% block title %}إدارة المستخدمين{% endblock %}

{% block body %}
<div class="page-header justify-content-between">
    <div class="page-title">
        <h2>قائمة المستخدمين والصلاحيات</h2>
        <p>إدارة الأدوار وصلاحيات الوصول للنظام</p>
    </div>
    <a href="{{ path('admin_user_new') }}" class="btn btn-primary">
        <i class="bi bi-person-plus-fill ms-2"></i> إضافة مستخدم جديد
    </a>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead>
                    <tr>
                        <th class="text-end ps-4" style="width: 30%;">المستخدم</th>
                        <th>البريد الإلكتروني</th>
                        <th>الهاتف</th>
                        <th>الصلاحيات</th>
                        <th class="text-start pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td class="text-end ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-sq ms-3" style="background: rgba(37, 99, 235, 0.08); color: var(--primary);">
                                    {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
                                </div>
                                <div>
                                    <div class="fw-800 text-main">{{ user.prenom }} {{ user.nom }}</div>
                                    <small class="text-muted fw-600">ID: #{{ user.id }}</small>
                                </div>
                            </div>
                        </td>
                        <td class="text-primary fw-600">{{ user.email }}</td>
                        <td class="fw-600">{{ user.numtlf ?: '-' }}</td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-center gap-1">
                            {% for role in user.roles %}
                                {% set label = null %}
                                {% set color = 'secondary' %}
                                {% if role == 'ROLE_ADMIN' %}{% set label = 'مدير' %}{% set color = 'danger' %}
                                {% elseif role == 'ROLE_SPECIALIST' %}{% set label = 'أخصائي' %}{% set color = 'primary' %}
                                {% elseif role == 'ROLE_PARENT' %}{% set label = 'ولي أمر' %}{% set color = 'secondary' %}
                                {% elseif role == 'ROLE_STAFF' %}{% set label = 'موظف' %}{% set color = 'secondary' %}
                                {% elseif role == 'ROLE_VOLUNTEER' %}{% set label = 'متطوع' %}{% set color = 'warning' %}
                                {% elseif role == 'ROLE_DONOR' %}{% set label = 'متبرع' %}{% set color = 'dark' %}
                                {% endif %}
                                {% if label %}
                                    <span class="badge-2026" style="background: var(--{{ color == 'secondary' ? 'text-muted' : (color == 'primary' ? 'primary' : (color == 'danger' ? 'danger' : (color == 'warning' ? 'warning' : 'text-main'))) }})0D; color: var(--{{ color == 'secondary' ? 'text-muted' : (color == 'primary' ? 'primary' : (color == 'danger' ? 'danger' : (color == 'warning' ? 'warning' : 'text-main'))) }});">
                                        {{ label }}
                                    </span>
                                {% endif %}
                            {% endfor %}
                            </div>
                        </td>
                        <td class="text-start pe-4">
                            <div class="d-flex gap-2 justify-content-start">
                                <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="action-btn-2026" title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                {{ include('admin/user/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="empty-state">
                                <i class="bi bi-shield-lock text-muted opacity-25" style="font-size: 4rem;"></i>
                                <p class="text-muted mt-3 fw-600">لا يوجد مستخدمون مسجلون حالياً.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .fw-800 { font-weight: 800; }
    .fw-700 { font-weight: 700; }
    .fw-600 { font-weight: 600; }
    
    th { font-weight: 800 !important; color: var(--text-muted) !important; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; }
</style>
{% endblock %}
