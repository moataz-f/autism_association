{% extends 'base.html.twig' %}

{% block title %}التقارير الشهرية للحضور{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-800 text-navy"><i class="bi bi-file-earmark-bar-graph ms-2"></i>التقارير الشهرية للحضور</h2>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="month" class="form-select-2026" onchange="this.form.submit()">
                {% for m in 1..12 %}
                    <option value="{{ "%02d"|format(m) }}" {{ currentMonth == "%02d"|format(m) ? 'selected' : '' }}>
                        {{ date('2024-' ~ m ~ '-01')|date('F') }}
                    </option>
                {% endfor %}
            </select>
            <select name="year" class="form-select-2026" onchange="this.form.submit()">
                {% for y in 2024..2026 %}
                    <option value="{{ y }}" {{ currentYear == y ? 'selected' : '' }}>{{ y }}</option>
                {% endfor %}
            </select>
        </form>
        <button onclick="window.print()" class="btn btn-2026-primary"><i class="bi bi-printer ms-1"></i> طباعة</button>
    </div>
</div>

<div class="card card-2026 border-0 shadow-sm overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light-2026">
                    <tr>
                        <th class="ps-4">الموظف</th>
                        <th>الدور</th>
                        <th class="text-center">أيام الحضور</th>
                        <th class="text-center">إجمالي الساعات</th>
                        <th class="text-center">نسبة الحضور</th>
                    </tr>
                </thead>
                <tbody>
                    {% for data in reportData %}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-800 text-navy">{{ data.personnel.prenom }} {{ data.personnel.nom }}</div>
                        </td>
                        <td>{{ data.personnel.role }}</td>
                        <td class="text-center">
                            <span class="badge-2026 bg-light text-navy fw-800">{{ data.daysPresent }} يوم</span>
                        </td>
                        <td class="text-center fw-900 text-primary">
                            {{ data.totalHours }} ساعة
                        </td>
                        <td class="text-center" style="width: 200px;">
                            {% set percent = (data.daysPresent / 22 * 100)|round %}
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px; border-radius: 10px; background: #EEE;">
                                    <div class="progress-bar bg-primary" style="width: {{ percent > 100 ? 100 : percent }}%"></div>
                                </div>
                                <span class="small fw-800 text-muted">{{ percent }}%</span>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
