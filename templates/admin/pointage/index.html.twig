{% extends 'base.html.twig' %}

{% block title %}سجل الحضور اليومي{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-800 text-navy"><i class="bi bi-clock-history ms-2"></i>سجل الحضور اليومي</h2>
    <div class="d-flex gap-3 align-items-center">
        <form method="get" class="d-flex gap-2">
            <input type="date" name="date" class="form-control-2026" value="{{ currentDate|date('Y-m-d') }}" onchange="this.form.submit()">
        </form>
        {% if is_granted('ROLE_SUPER_ADMIN') %}
        <a href="{{ path('admin_pointage_print_daily') }}" target="_blank" class="btn btn-2026-primary">
            <i class="bi bi-qr-code ms-1"></i> طباعة رموز اليوم
        </a>
        {% endif %}
        <a href="{{ path('admin_pointage_reports') }}" class="btn btn-2026-light border">
            <i class="bi bi-file-earmark-bar-graph ms-1"></i> التقارير الشهرية
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card card-2026 border-0 shadow-sm overflow-hidden h-100">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                <thead class="bg-light-2026">
                    <tr>
                        <th class="ps-4">الموظف</th>
                        <th>الدخول</th>
                        <th>الخروج</th>
                        <th>المدة</th>
                        <th>الحالة</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in pointages %}
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-800" style="width: 40px; height: 40px;">
                                    {{ p.personnel.nom|first }}
                                </div>
                                <div>
                                    <div class="fw-800 text-navy">{{ p.personnel.prenom }} {{ p.personnel.nom }}</div>
                                    <small class="text-muted">{{ p.personnel.role }}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge-2026 bg-light text-success fw-800">
                                <i class="bi bi-box-arrow-in-left ms-1"></i> {{ p.heureEntree|date('H:i') }}
                            </span>
                        </td>
                        <td>
                            {% if p.heureSortie %}
                                <span class="badge-2026 bg-light text-warning fw-800">
                                    <i class="bi bi-box-arrow-right ms-1"></i> {{ p.heureSortie|date('H:i') }}
                                </span>
                            {% else %}
                                <span class="badge-2026 bg-light text-muted fw-700 italic">في العمل...</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if p.heureSortie %}
                                <div class="fw-800 text-navy">
                                    {{ p.duree.h }} س {{ p.duree.i }} د
                                </div>
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>
                            {% if p.heureSortie %}
                                <span class="badge-2026 bg-success">مكتمل</span>
                            {% else %}
                                <span class="badge-2026 bg-primary pulse-soft text-white">حاضر</span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-4">
                            <button class="action-btn-2026"><i class="bi bi-info-circle"></i></button>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-calendar-x text-muted opacity-25" style="font-size: 4rem;"></i>
                            <p class="text-muted mt-3 fw-800">لا توجد سجلات لهذا التاريخ</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>

{% if is_granted('ROLE_SUPER_ADMIN') %}
<div class="col-lg-4">
<div class="card card-2026 border-0 shadow-sm h-100 p-4 text-center">
    <h5 class="fw-800 text-navy mb-4"><i class="bi bi-qr-code ms-2"></i>رموز الاستجابة لليوم</h5>
    
    <div class="mb-4">
        <label class="fw-700 text-muted small d-block mb-3">باركود الدخول (Check-In)</label>
        <div id="daily-in" class="mx-auto qr-station-box"></div>
        <p class="mt-2 fw-800 text-success small">دخول</p>
    </div>

    <hr class="opacity-10">

    <div class="mt-4">
        <label class="fw-700 text-muted small d-block mb-3">باركود الخروج (Check-Out)</label>
        <div id="daily-out" class="mx-auto qr-station-box"></div>
        <p class="mt-2 fw-800 text-warning small">خروج</p>
    </div>

    <div class="mt-auto pt-4">
        <div class="p-3 rounded-20 bg-light-2026 small fw-700 text-muted">
            <i class="bi bi-info-circle ms-1"></i> هذه الرموز ثابتة لليوم ومخصصة للهواتف.
        </div>
    </div>
</div>
</div>
{% else %}
<div class="col-lg-4">
    <div class="card card-2026 border-0 shadow-sm h-100 p-5 d-flex flex-column align-items-center justify-content-center text-center">
        <div class="stat-icon-2026 mb-4" style="background: rgba(37, 99, 235, 0.05); color: var(--primary); width: 80px; height: 80px; font-size: 2.5rem;">
            <i class="bi bi-shield-check"></i>
        </div>
        <h5 class="fw-900 text-navy mb-3">إدارة الحضور</h5>
        <p class="text-muted fw-600 mb-0">يمكنك مراجعة سجلات الدخول والخروج والتقارير الشهرية. طباعة الرموز وإدارة المحطات متاحة للمدير العام فقط.</p>
    </div>
</div>
{% endif %}
</div>

<style>
    .qr-station-box img {
        margin: 0 auto;
        padding: 10px;
        background: white;
        border: 1px solid #EDF2F7;
        border-radius: 16px;
        width: 160px !important;
        height: 160px !important;
    }
    .rounded-20 { border-radius: 20px; }
    .avatar-sm { font-size: 0.9rem; }
    .pulse-soft { animation: pulseSoft 2s infinite; }
    @keyframes pulseSoft {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.05); opacity: 0.8; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

{% if is_granted('ROLE_SUPER_ADMIN') %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    {% set dailySecret = currentDate|date('Y-m-d') %}
    
    // QR Daily Entry
    new QRCode(document.getElementById("daily-in"), {
        text: "DAILY:IN:{{ dailySecret }}",
        width: 180,
        height: 180,
        colorDark : "#10B981",
        colorLight : "#ffffff",
        correctLevel : QRCode.CorrectLevel.H
    });

    // QR Daily Exit
    new QRCode(document.getElementById("daily-out"), {
        text: "DAILY:OUT:{{ dailySecret }}",
        width: 180,
        height: 180,
        colorDark : "#F59E0B",
        colorLight : "#ffffff",
        correctLevel : QRCode.CorrectLevel.H
    });
</script>
{% endif %}
{% endblock %}
