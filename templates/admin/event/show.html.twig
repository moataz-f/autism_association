{% extends 'base.html.twig' %}

{% block title %}Détails de l'Événement{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-0">{{ event.title }}</h2>
        <p class="text-muted">Détails et missions associées</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_event_edit', {'id': event.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Modifier
        </a>
        <a href="{{ path('admin_event_index') }}" class="btn btn-light">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-900 mb-4 border-bottom pb-2">Informations</h5>
                <div class="mb-3">
                    <label class="text-muted small d-block">Personnel assigné</label>
                    <div class="fw-800">{{ event.personnel.nom }} {{ event.personnel.prenom }}</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Période</label>
                    <div class="fw-800">
                        Du: {{ event.startDate|date('Y-m-d H:i') }}<br>
                        Au: {{ event.endDate|date('Y-m-d H:i') }}
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Description</label>
                    <p>{{ event.description ?: 'Aucune description' }}</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-0">
                <div class="p-4 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="fw-900 mb-0">Missions liées</h5>
                    <a href="{{ path('admin_task_new', {'event': event.id, 'personnel': event.personnel.id}) }}" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle"></i> Ajouter une mission
                    </a>
                </div>
                {% if event.tasks|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Titre</th>
                                    <th>Échéance</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for task in event.tasks %}
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-800">{{ task.title }}</div>
                                            <small class="text-muted">{{ task.description|slice(0, 30) }}...</small>
                                        </td>
                                        <td>{{ task.dueDate ? task.dueDate|date('Y-m-d H:i') : '-' }}</td>
                                        <td>
                                            {% if task.status == 'COMPLETED' %}
                                                <span class="badge bg-success-subtle text-success">Terminé</span>
                                            {% else %}
                                                <span class="badge bg-warning-subtle text-warning">En cours</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center p-5">
                        <i class="bi bi-clipboard text-muted opacity-25" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-2">Aucune mission pour cet événement.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
