{% extends 'base.html.twig' %}

{% block title %}Gestion des Événements{% endblock %}

{% block body %}
<div class="page-header justify-content-between">
    <div class="page-title">
        <h2>Gestion des Événements</h2>
        <p>Planifier des horaires spéciaux et activités pour le personnel</p>
    </div>
    <a href="{{ path('admin_event_new') }}" class="btn btn-primary">
        <i class="bi bi-calendar-plus ms-2"></i> Créer un événement
    </a>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        {% if events|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Événement</th>
                            <th>Assigné à</th>
                            <th>Missions</th>
                            <th>Début</th>
                            <th>Fin</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for event in events %}
                        <tr>
                            <td class="ps-4">
                                <div class="fw-800 text-main">{{ event.title }}</div>
                                <small class="text-muted">{{ event.description|slice(0, 50) }}...</small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle-sm bg-info-subtle text-info me-2">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <span>{{ event.personnel.nom }} {{ event.personnel.prenom }}</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary">
                                    {{ event.tasks|length }} mission(s)
                                </span>
                            </td>
                            <td>{{ event.startDate|date('Y-m-d H:i') }}</td>
                            <td>{{ event.endDate|date('Y-m-d H:i') }}</td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="{{ path('admin_event_show', {'id': event.id}) }}" class="btn btn-sm btn-light text-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_event_edit', {'id': event.id}) }}" class="btn btn-sm btn-light text-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin_event_delete', {'id': event.id}) }}" onsubmit="return confirm('Supprimer cet événement ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                        <button class="btn btn-sm btn-light text-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="empty-state text-center p-5">
                <i class="bi bi-calendar-event text-muted opacity-25" style="font-size: 5rem;"></i>
                <h5 class="mt-3">Aucun événement planifié</h5>
                <p class="text-muted">Planifiez des activités spéciales pour votre équipe dès maintenant.</p>
                <a href="{{ path('admin_event_new') }}" class="btn btn-primary mt-3">Créer un événement</a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
