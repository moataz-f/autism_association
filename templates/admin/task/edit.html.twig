{% extends 'base.html.twig' %}

{% block title %}Modifier la Tâche{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-0">Modifier la Tâche</h2>
    </div>
    <a href="{{ path('admin_task_index') }}" class="btn btn-light">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form) }}
                    <div class="mb-4">
                        {{ form_row(form.title, {'attr': {'class': 'form-control-2026'}}) }}
                    </div>
                    <div class="mb-4">
                        {{ form_row(form.description, {'attr': {'class': 'form-control-2026'}}) }}
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            {{ form_row(form.personnel, {'attr': {'class': 'form-select-2026'}}) }}
                        </div>
                        <div class="col-md-6 mb-4">
                            {{ form_row(form.dueDate, {'attr': {'class': 'form-control-2026'}}) }}
                        </div>
                    </div>
                    <div class="mb-4">
                        {{ form_row(form.status, {'attr': {'class': 'form-select-2026'}}) }}
                    </div>
                    
                    <button class="btn btn-primary w-100 py-3 fw-bold">
                        <i class="bi bi-check2-circle"></i> Mettre à jour
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
