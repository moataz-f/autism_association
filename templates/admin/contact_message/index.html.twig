{% extends 'base.html.twig' %}

{% block title %}رسائل التواصل{% endblock %}

{% block body %}
<div class="page-header">
    <div class="page-title">
        <h2>رسائل التواصل والاستفسارات</h2>
        <p>إدارة الرسائل الواردة من الموقع العام</p>
    </div>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">التاريخ</th>
                    <th>المرسل</th>
                    <th>الموضوع</th>
                    <th>الحالة</th>
                    <th class="text-end pe-4">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                {% for msg in messages %}
                    <tr class="{% if not msg.isRead %}fw-bold bg-light bg-opacity-50{% endif %}">
                        <td class="ps-4">
                            <span class="text-muted small">{{ msg.createdAt|date('Y-m-d H:i') }}</span>
                        </td>
                        <td>
                            <div>{{ msg.fullName }}</div>
                            <div class="small text-muted">{{ msg.email }}</div>
                        </td>
                        <td>{{ msg.subject|default('بدون موضوع') }}</td>
                        <td>
                            {% if msg.isRead %}
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">مقروءة</span>
                            {% else %}
                                <span class="badge bg-primary rounded-pill px-3">جديدة</span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-4">
                            <a href="{{ path('admin_contact_message_show', {id: msg.id}) }}" class="btn btn-sm btn-light rounded-pill px-3">
                                عرض التفاصيل
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">لا توجد رسائل حالياً.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
