{% extends 'base.html.twig' %}

{% block title %}الجدول الزمني للحصص{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css' rel='stylesheet' />
    <style>
        .fc { 
            background: white; 
            padding: 20px; 
            border-radius: 24px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.02);
            font-family: 'Inter', 'Noto Sans Arabic', sans-serif;
        }
        .fc-header-toolbar { padding: 10px; }
        .fc-button-primary {
            background-color: var(--primary) !important;
            border-color: var(--primary) !important;
            border-radius: 12px !important;
            font-weight: 700 !important;
        }
        .fc-event {
            border-radius: 8px !important;
            border: none !important;
            padding: 4px 8px !important;
            cursor: pointer;
            transition: transform 0.2s ease;
        }
        .fc-event:hover { transform: scale(1.02); }
        .fc-toolbar-title { font-weight: 800 !important; color: var(--navy); }
        .fc-day-today { background: rgba(142, 151, 253, 0.03) !important; }
        
        #eventModal {
            backdrop-filter: blur(5px);
        }
        .modal-content {
            border-radius: 32px;
            border: none;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
        }
    </style>
{% endblock %}

{% block body %}
<div class="page-header justify-content-between">
    <div class="page-title">
        <h2>الجدول الزمني العام</h2>
        <p>عرض تفاعلي لجميع الحصص المبرمجة</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_seance_index') }}" class="btn btn-outline-primary rounded-pill">
            <i class="bi bi-list-ul ms-2"></i> عرض القائمة
        </a>
        <a href="{{ path('admin_seance_new') }}" class="btn btn-primary rounded-pill">
            <i class="bi bi-plus-lg ms-2"></i> إضافة حصة
        </a>
    </div>
</div>

<div id='calendar'></div>

<!-- Event Info Modal -->
<div class="modal fade" id="eventModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-800 text-navy" id="eventTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-primary-light rounded-20">
                            <i class="bi bi-person-badge text-primary fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block fw-700">الأخصائي المسؤول</small>
                            <span id="eventSpecialiste" class="fw-800 text-navy"></span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-info-light rounded-20">
                            <i class="bi bi-people text-info fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block fw-700">عدد الأطفال</small>
                            <span id="eventBeneficiaires" class="fw-800 text-navy"></span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 bg-light rounded-20">
                            <i class="bi bi-clock text-dark fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block fw-700">التوقيت</small>
                            <span id="eventTime" class="fw-800 text-navy"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <a href="#" id="eventUrl" class="btn btn-primary w-100 rounded-pill py-2 fw-bold">عرض كامل التفاصيل</a>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var modal = new bootstrap.Modal(document.getElementById('eventModal'));
            
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                locale: 'ar',
                direction: 'rtl',
                firstDay: 1, // Monday
                slotMinTime: '08:00:00',
                slotMaxTime: '18:00:00',
                allDaySlot: false,
                events: '{{ path("admin_seance_api_events") }}',
                eventClick: function(info) {
                    info.jsEvent.preventDefault();
                    
                    document.getElementById('eventTitle').innerText = info.event.title;
                    document.getElementById('eventSpecialiste').innerText = info.event.extendedProps.specialiste;
                    document.getElementById('eventBeneficiaires').innerText = info.event.extendedProps.beneficiaires + ' أطفال';
                    document.getElementById('eventTime').innerText = info.event.start.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) + ' - ' + info.event.end.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                    document.getElementById('eventUrl').href = info.event.url;
                    
                    modal.show();
                }
            });
            calendar.render();
        });
    </script>
{% endblock %}
