{% extends 'base.html.twig' %}

{% block title %}إدارة الحصص{% endblock %}

{% block body %}
<div class="page-header justify-content-between">
    <div class="page-title">
        <h2>برنامج الحصص والجلسات</h2>
        <p>متابعة الجدولة الزمنية للحصص الفردية والجماعية</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_seance_planning') }}" class="btn btn-outline-primary">
            <i class="bi bi-calendar-week ms-2"></i> الجدولة الزمنية
        </a>
        <a href="{{ path('admin_seance_new') }}" class="btn btn-primary">
            <i class="bi bi-calendar-plus ms-2"></i> إضافة حصة جديدة
        </a>
    </div>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead>
                    <tr>
                        <th class="text-end ps-4">الحصة / الموضوع</th>
                        <th>النوع</th>
                        <th>التاريخ والوقت</th>
                        <th>الأخصائي</th>
                        <th>المشاركون</th>
                        <th>الحالة</th>
                        <th class="text-start pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                {% for seance in seances %}
                    <tr>
                        <td class="text-end ps-4">
                            <div class="fw-800 text-main">{{ seance.titre }}</div>
                            <small class="text-muted fw-600">ID: #{{ seance.id }}</small>
                        </td>
                        <td>
                            {% set type_color = seance.type == 'Individuelle' ? 'primary' : 'secondary' %}
                            <span class="badge-2026" style="background: var(--{{ type_color }})0D; color: var(--{{ type_color }});">
                                <i class="bi {{ seance.type == 'Individuelle' ? 'bi-person' : 'bi-people' }} ms-1"></i>
                                {{ seance.type == 'Individuelle' ? 'فردية' : 'جماعية' }}
                            </span>
                        </td>
                        <td class="fw-600">
                            <div>{{ seance.date|date('Y-m-d') }}</div>
                            <small class="text-muted fw-700">
                                {{ seance.heureDebut|date('H:i') }} <i class="bi bi-arrow-left small mx-1"></i> {{ seance.heureFin|date('H:i') }}
                            </small>
                        </td>
                        <td class="fw-700 text-muted">{{ seance.specialiste.prenom }} {{ seance.specialiste.nom }}</td>
                        <td>
                            <span class="badge-2026 bg-light text-main border">
                                {{ seance.beneficiaires|length }} أطفال
                            </span>
                        </td>
                        <td>
                            {% set status_label = '' %}
                            {% set status_color = 'secondary' %}
                            {% if seance.etat == 'Planned' %}{% set status_label = 'مبرمجة' %}{% set status_color = 'primary' %}
                            {% elseif seance.etat == 'Completed' %}{% set status_label = 'تمت' %}{% set status_color = 'secondary' %}
                            {% elseif seance.etat == 'Cancelled' %}{% set status_label = 'ملغاة' %}{% set status_color = 'danger' %}
                            {% endif %}
                            <div class="d-flex align-items-center justify-content-center">
                                <span class="dot-indicator bg-{{ status_color }} ms-2"></span>
                                <span class="fw-700 text-{{ status_color }}">{{ status_label }}</span>
                            </div>
                        </td>
                        <td class="text-start pe-4">
                            <div class="d-flex gap-2 justify-content-start">
                                <a href="{{ path('admin_seance_show', {'id': seance.id}) }}" class="action-btn-2026" title="عرض التفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('admin_seance_edit', {'id': seance.id}) }}" class="action-btn-2026" title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('admin_seance_delete', {'id': seance.id}) }}" onsubmit="return confirm('هل أنت متأكد من حذف هذه الحصة؟');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ seance.id) }}">
                                    <button class="action-btn-2026" style="color: var(--danger); border-color: rgba(239, 68, 68, 0.1);" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="empty-state">
                                <i class="bi bi-calendar-x text-muted opacity-25" style="font-size: 4rem;"></i>
                                <p class="text-muted mt-3 fw-600">لا توجد حصص مبرمجة حالياً.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .fw-800 { font-weight: 800; }
    .fw-700 { font-weight: 700; }
    .fw-600 { font-weight: 600; }
    .dot-indicator { height: 8px; width: 8px; border-radius: 50%; display: inline-block; }
    th { font-weight: 800 !important; color: var(--text-muted) !important; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; }
</style>
{% endblock %}
