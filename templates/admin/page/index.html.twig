{% extends 'base.html.twig' %}

{% block title %}إدارة الصفحات الثابتة{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-800 text-navy"><i class="bi bi-file-earmark-text"></i> إدارة الصفحات الثابتة</h2>
    <a href="{{ path('admin_page_new') }}" class="btn btn-2026-primary">
        <i class="bi bi-plus-circle ms-1"></i> إضافة صفحة جديدة
    </a>
</div>

<div class="card card-2026 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light-2026">
                    <tr>
                        <th class="ps-4">الصفحة</th>
                        <th>الرابط (Slug)</th>
                        <th>الحالة</th>
                        <th class="text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    {% for page in pages %}
                    <tr>
                        <td class="ps-4">
                            <h6 class="fw-800 text-navy mb-0">{{ page.titre }}</h6>
                        </td>
                        <td>
                            <code class="text-primary">/p/{{ page.slug }}</code>
                        </td>
                        <td>
                            {% if page.actif %}
                                <span class="badge-2026 bg-success">نشط</span>
                            {% else %}
                                <span class="badge-2026 bg-secondary">غير نشط</span>
                            {% endif %}
                        </td>
                        <td class="text-center pe-4">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('admin_page_edit', {id: page.id}) }}" class="action-btn-2026">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('admin_page_delete', {id: page.id}) }}" style="display:inline" onsubmit="return confirm('هل أنت متأكد من حذف هذه الصفحة؟');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ page.id) }}">
                                    <button class="action-btn-2026 text-danger" style="background: #FFF5F5; border-color: #FED7D7;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <i class="bi bi-file-earmark-plus text-muted opacity-25" style="font-size: 4rem;"></i>
                            <p class="text-muted mt-3 fw-800">لا توجد صفحات حالياً</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
