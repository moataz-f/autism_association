{# templates/admin/donation/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}حملات التبرع{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-cash-stack"></i> إدارة حملات التبرع</h2>
    <a href="{{ path('admin_donation_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> إضافة حملة جديدة
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>العنوان</th>
                        <th>المبلغ المطلوب</th>
                        <th>المبلغ المجموع</th>
                        <th>النسبة</th>
                        <th>الحالة</th>
                        <th>رئيسية</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    {% for campaign in campaigns %}
                    <tr>
                        <td>{{ campaign.titre }}</td>
                        <td>{{ campaign.montantObjectif }} د.ت</td>
                        <td>{{ campaign.montantCollecte }} د.ت</td>
                        <td>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar" role="progressbar" style="width: {{ campaign.pourcentage }}%">
                                    {{ campaign.pourcentage }}%
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if campaign.actif %}
                                <span class="badge bg-success">نشطة</span>
                            {% else %}
                                <span class="badge bg-secondary">غير نشطة</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if campaign.principale %}
                                <i class="bi bi-star-fill text-warning"></i>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('admin_donation_edit', {id: campaign.id}) }}" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('admin_donation_delete', {id: campaign.id}) }}" style="display:inline" onsubmit="return confirm('هل أنت متأكد؟');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ campaign.id) }}">
                                <button class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center">لا توجد حملات</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}