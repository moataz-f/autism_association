{% extends 'base_public.html.twig' %}

{% block title %}معرض الصور{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-900 text-primary mb-3">معرض لحظاتنا</h1>
        <p class="lead text-muted mx-auto" style="max-width: 700px;">
            جولة بصرية في يوميات أبطالنا وأنشطة الجمعية.
        </p>
    </div>

    <div class="row g-4" data-masonry='{"percentPosition": true }'>
        {% for image in images %}
            <div class="col-sm-6 col-lg-4">
                <div class="card border-0 rounded-4 overflow-hidden shadow-sm hover-zoom">
                    <div class="img-wrapper" style="height: 300px; overflow: hidden;">
                         <img src="{{ vich_uploader_asset(image, 'imageFile') }}" class="w-100 h-100 object-fit-cover" alt="{{ image.titre }}">
                    </div>
                    <div class="card-body bg-white p-3 text-center">
                        <h5 class="card-title fw-bold mb-1">{{ image.titre }}</h5>
                        {% if image.description %}
                            <p class="card-text text-muted small">{{ image.description }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <i class="bi bi-images text-muted opacity-25" style="font-size: 4rem;"></i>
                <h3 class="mt-3 text-muted fw-bold">المعرض فارغ حالياً</h3>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    .hover-zoom .img-wrapper img { transition: transform 0.5s ease; }
    .hover-zoom:hover .img-wrapper img { transform: scale(1.1); }
    .object-fit-cover { object-fit: cover; }
</style>
{% endblock %}
