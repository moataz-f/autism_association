{% extends 'base.html.twig' %}

{% block title %}تفاصيل العائلة{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-0">تفاصيل العائلة</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">لوحة القيادة</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_famille_index') }}">العائلات</a></li>
                <li class="breadcrumb-item active">تفاصيل</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_famille_index') }}" class="btn btn-light">
            <i class="bi bi-arrow-right"></i> العودة للقائمة
        </a>
        <a href="{{ path('app_famille_edit', {'id': famille.id}) }}" class="btn btn-primary">
            <i class="bi bi-pencil"></i> تعديل
        </a>
        <form method="post" action="{{ path('app_famille_delete', {'id': famille.id}) }}" onsubmit="return confirm('هل أنت متأكد من حذف هذه العائلة؟ سيتم حذف جميع الأطفال المرتبطين بها أيضاً.');" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ famille.id) }}">
            <button class="btn btn-danger text-white">
                <i class="bi bi-trash"></i> حذف
            </button>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 text-primary fw-bold">معلومات المسؤول</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase">الإسم الكامل</label>
                        <p class="fs-5 fw-bold">{{ famille.nomResponsable }} {{ famille.prenomResponsable }}</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase">تاريخ التسجيل</label>
                        <p class="fs-5">{{ famille.dateInscription|date('Y-m-d') }}</p>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase">رقم الهاتف</label>
                        <div class="d-flex align-items-center mt-1">
                            <i class="bi bi-telephone text-primary me-2"></i>
                            <span class="fs-5">{{ famille.telephone }}</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase">البريد الإلكتروني</label>
                        <div class="d-flex align-items-center mt-1">
                            <i class="bi bi-envelope text-primary me-2"></i>
                            <span class="fs-5">{{ famille.email|default('غير متوفر') }}</span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="text-muted small fw-bold text-uppercase">العنوان</label>
                    <div class="d-flex align-items-center mt-1">
                        <i class="bi bi-geo-alt text-danger me-2"></i>
                        <span class="fs-5">{{ famille.adresse|default('غير محدد') }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">الأطفال المسجلين</h5>
                <span class="badge bg-primary rounded-pill">{{ famille.beneficiaires|length }}</span>
            </div>
            <div class="list-group list-group-flush">
                {% for beneficiaire in famille.beneficiaires %}
                    <a href="{{ path('app_beneficiaire_show', {'id': beneficiaire.id}) }}" class="list-group-item list-group-item-action p-3 d-flex align-items-center">
                        <div class="avatar-circle-sm bg-success text-white me-3">
                            {{ beneficiaire.prenom|first }}
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">{{ beneficiaire.prenom }} {{ beneficiaire.nom }}</h6>
                            <small class="text-muted">
                                {{ beneficiaire.age }} سنة • 
                                {% if beneficiaire.genre == 'Masculin' %}ذكر{% else %}أنثى{% endif %}
                            </small>
                        </div>
                        <i class="bi bi-chevron-left ms-auto text-muted small"></i>
                    </a>
                {% else %}
                    <div class="p-5 text-center">
                        <i class="bi bi-emoji-neutral text-muted opacity-25" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-3 mb-0">لا يوجد أطفال مسجلين لهذه العائلة بعد</p>
                        <a href="{{ path('app_beneficiaire_new') }}" class="btn btn-sm btn-outline-primary mt-3">
                            <i class="bi bi-plus-lg"></i> إضافة طفل
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
